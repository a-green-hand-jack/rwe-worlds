nts: embedded TrueType (pdf.fonttype 42), no Type 3.\nUnits: inches; type sizes in points.\n\"\"\"\nCOLUMN_WIDTH_IN = 5.5    # width of one column as printed\nTEXT_WIDTH_IN = 5.5      # full text width as printed\nMIN_FONT_PT = 7.0        # smallest type size the venue accepts in figures/tables\n\n# Used only for drafts (never delivered): NeurIPS-like single column\n/hutian/w/out/fig2_main.pdf\n/hutian/w/out/fig3_gap.pdf: 24 text spans, min 7.00 pt, fonts {'DCGJNN+DejaVuSans-Oblique': 'Type0', 'ENMEHH+DejaVuSans': 'Type0'}\n```", "exit": null}}}, {"id": "760eb627-f61c-5741-aec9-b1d69692671a", "at": 1795624048.8693569, "clock": "host", "stream": "runner", "sequence": 12424, "layer": "worker", "category": "usage", "kind": "session.usage", "role": "figtab-repo", "actor": "figtab-repo", "execution_id": "ffbe3f7884f4340b89a3194a68cf3c81", "trust": "agent-reported", "outcome": null, "label": "usage", "repository": null, "flags": [], "causes": [], "summary": "context usage"}, {"id": "63849643-7e16-58a0-8b8a-99de7a78a195", "at": 1795624048.9001515, "clock": "host", "stream": "runner", "sequence": 12426, "layer": "worker", "category": "message", "kind": "session.session/request_permission", "role": "figtab-repo", "actor": "figtab-repo", "execution_id": "ffbe3f7884f4340b89a3194a68cf3c81", "trust": "agent-reported", "outcome": null, "label": "message", "repository": null, "flags": [], "causes": [], "summary": "session/request_permission"}, {"id": "48378523-308b-5002-ad05-aebd061179b6", "at": 1795624048.904685, "clock": "host", "stream": "runner", "sequence": 12427, "layer": "worker", "category": "message", "kind": "session.response", "role": "figtab-repo", "actor": "figtab-repo", "execution_id": "ffbe3f7884f4340b89a3194a68cf3c81", "trust": "agent-reported", "outcome": null, "label": "message", "repository": null, "flags": [], "causes": [], "summary": "response"}, {"id": "d1c137e4-d6d7-5074-a7b6-a40d550bfe6f", "at": 1795624058.7409678, "until": 1795624064.683039, "clock": "host