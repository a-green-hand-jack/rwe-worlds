"""Fig. 8 (claim: greedy A beats random on the real, sparse MTEB score matrix; review M1).

Top row: closure C(k) of greedy A and random selection, factor model (fa) and pairwise-complete correlation (pw) predictors,
one column per pool (density = share of observed cells). Bottom row: paired gap greedy A minus random, same predictor, with
the family-clustered bootstrap CI. Negative gap = greedy A better. Pools are separate columns, never pooled.
"""
import argparse, os
import pandas as pd
import style, venue
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D

p = argparse.ArgumentParser()
p.add_argument("--results", required=True); p.add_argument("--out", default="out")
p.add_argument("--subsets", nargs="+", default=["eng_d30", "eng_d50", "eng_d70", "all_d30"])
p.add_argument("--draft", action="store_true")
a = p.parse_args()
v = venue.get(a.draft)
size = style.setup(v["TEXT_WIDTH_IN"], v["MIN_FONT_PT"], height_in=3.3)
rd = lambda n: (pd.read_csv(os.path.join(a.results, n)), os.path.join(a.results, n))
clo, p1 = rd("sparse_closure.csv"); gap, p2 = rd("sparse_gap.csv"); sub, p3 = rd("sparse_subsets.csv"); ref, p4 = rd("sparse_run_info.csv")
PRED = [("fa", "-", style.PRED_LABELS["fa"]), ("pw", "--", "pairwise correlation")]
TITLE = {"eng": "MTEB-Eng", "all": "MTEB all tasks"}
fig, axs = plt.subplots(2, len(a.subsets), figsize=size, sharex=True, squeeze=False)
meta = {}
for j, s in enumerate(a.subsets):
    ax, bx = axs[0, j], axs[1, j]
    sb = sub[sub.subset == s].iloc[0]; ri = ref[ref.subset == s].iloc[0]
    for sel in ("random", "greedyA"):
        for pi, (pr, ls, _) in enumerate(PRED):
            d = clo[(clo.subset == s) & (clo.selector == sel) & (clo.predictor == pr)].sort_values("k")
            kw = dict(color=style.COLORS[sel], marker=style.MARKERS[sel], ls=ls, ms=2.8, lw=1.0, mfc=style.COLORS[sel] if pi == 0 else "white", mew=0.8)
            ax.plot(d.k, d.closure, **kw)
            if sel == "greedyA" and pi == 0:
                ax.fill_between(d.k, d.ci_lo, d.ci_hi, color=kw["color"], alpha=0.18, lw=0)
    ax.axhline(0.9, color="0.5", lw=0.9); ax.axhline(0, color="0.7", lw=0.5)
    ax.set_ylim(-0.25, 1.1)
    for pi, (pr, ls, _) in enumerate(PRED):
        g = gap[(gap.subset == s) & (gap.predictor == pr)].sort_values("k")
        off = 1.0 + 0.05 * (2 * pi - 1)
        bx.errorbar(g.k * off, g.gap, yerr=[g.gap - g.ci_lo, g.ci_hi - g.gap], fmt="o" + ls, ms=2.8, lw=0.9, capsize=1.2,
                    color=style.COLORS["greedyA"], mfc=style.COLORS["greedyA"] if pi == 0 else "white", mew=0.8)
    bx.axhline(0, color="0.3", lw=0.8)
    bx.set_xscale("log"); bx.set_xticks([1, 3, 10, 20]); bx.set_xticklabels(["1", "3", "10", "20"]); bx.xaxis.set_minor_locator(plt.NullLocator())
    ax.xaxis.set_minor_locator(plt.NullLocator()); bx.set_xlabel("benchmarks run, $k$")
    ax.set_title(f"{TITLE[s.split('_')[0]]}\n{100*sb.density:.0f}% observed\n{int(ri.n_tested_models)} models", fontsize=7)
    if j == 0:
        ax.set_ylabel(r"closure $C(k)$"); bx.set_ylabel("greedy A $-$ random\n(std. RMSE)")
    else:
        ax.tick_params(labelleft=False)
    meta[s] = dict(density=float(sb.density), n_models=int(sb.n_models), n_tasks=int(sb.n_tasks), n_tested=int(ri.n_tested_models),
                   ks=[int(x) for x in sorted(g.k.unique())])
gs = gap[gap.subset.isin(a.subsets)]
lo_, hi_ = gs.ci_lo.min(), gs.ci_hi.max()
for j in range(len(a.subsets)):
    axs[1, j].set_ylim(lo_ - 0.02, hi_ + 0.02)
    if j: axs[1, j].tick_params(labelleft=False)
hs = [Line2D([], [], color=style.COLORS[s], marker=style.MARKERS[s], ms=2.8, lw=1.0, label=style.LABELS[s]) for s in ("greedyA", "random")]
hp = [Line2D([], [], color="0.25", ls=ls, marker="o", ms=2.8, lw=1.0, mfc="0.25" if i == 0 else "white", label=l) for i, (_, ls, l) in enumerate(PRED)]
hr = [Line2D([], [], color="0.5", lw=0.9, label="closure 0.9")]
fig.legend(hs + hp + hr, [h.get_label() for h in hs + hp + hr], loc="outside lower center", ncol=3, columnspacing=1.2, handlelength=2.2)
print(style.save(fig, "fig8_sparse", a.out, dict(claim="C2 (sparse matrix, review M1)", inputs={x: style.sha(x) for x in (p1, p2, p3, p4)}, panels=meta,
                                                 band="greedy A with the factor model only; family-clustered bootstrap 95%",
                                                 note="identity transform; grid k=1-6,8,10,12,15,20; models with <30 observed cells not tested; closure may exceed 1")))
