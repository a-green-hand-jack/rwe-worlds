"""Small-N LLM panels (case studies, no k*/H1 verdict: N < 12): HELM Lite v1.13.0 core scenarios (10 scenarios) and HELM Capabilities (5 scenarios, the
'Mean score' column dropped) -> data_out/helm_lite.npz, data_out/helm_capabilities.npz.  Models with any missing cell are dropped (counts printed).
Family key = first word of the model name (lower case), the same rule as for HELM MMLU with the same merges.
Run: python3 build_small_panels.py <parsed_dir> <out_dir>"""
import sys, numpy as np, pandas as pd
d, out = sys.argv[1:3]
def fam(n):
    if n.startswith("Amazon Nova"): return "nova"
    if n.startswith("Command R"): return "command"
    w = n.split()[0].split("-")[0].lower(); return {"mixtral": "mistral"}.get(w, w)
for name, f, drop in (("helm_lite", "helm_lite_accuracy.csv", []), ("helm_capabilities", "helm_capabilities_accuracy.csv", ["Mean score"])):
    t = pd.read_csv(f"{d}/{f}", index_col=0).drop(columns=drop); n0 = len(t); t = t.dropna()
    fm = np.array([fam(m) for m in t.index])
    np.savez(f"{out}/{name}.npz", X=t.values.astype(float), models=np.array(t.index), tasks=np.array(t.columns), family=fm, family_org=fm)
    print(name, "models", n0, "->", len(t), "complete; benchmarks", t.shape[1], "families", len(set(fm)))
