"""Table 4 (claim C4): median/max relative gap between predicted and empirical reducible risk, per data set and tier."""
import argparse, os, json
import pandas as pd
import style

p = argparse.ArgumentParser()
p.add_argument("--results", required=True); p.add_argument("--out", default="out")
a = p.parse_args()
g = pd.read_csv(os.path.join(a.results, "theory_gap.csv"))
sh = pd.read_csv(os.path.join(a.results, "theory_shape.csv"))[["dataset", "tier", "median_rel_gap_of_k_dependent_part"]]
g = g.merge(sh, on=["dataset", "tier"], how="left")
ORDER_T = ["true", "fitted", "bootstrap", "real"]; ORDER_D = ["synthetic_N60_r4_M60", "synthetic_N60_r4", "synthetic_N60_r4_M250", "synthetic_N60_r4_M600", "synthetic_N60_r4_M2000", "mteb_eng", "mteb_multi", "helm_mmlu"]
NAME = dict(style.DATASET_SHORT, **{f"synthetic_N60_r4{s}": f"Synthetic, $M{{=}}{m}$" for s, m in
            (("_M60", 60), ("", 110), ("_M250", 250), ("_M600", 600), ("_M2000", 2000))})
TLAB = {"true": "true parameters", "fitted": "fitted parameters", "bootstrap": "bootstrap from fitted model", "real": "real data"}
g["o1"] = g.dataset.map(ORDER_D.index); g["o2"] = g.tier.map(ORDER_T.index); g = g.sort_values(["o1", "o2"])
pc = lambda x: "--" if pd.isna(x) else f"{100 * x:.1f}"
lines = [r"\begin{tabular}{@{}llcccc@{}}", r"\toprule",
         r" & & \multicolumn{3}{c}{Relative gap (\%)} & \\ \cmidrule(lr){3-5}",
         r"Data & Risk computed with & Median & Max & $k$-dep. part & $k$ used \\", r"\midrule"]
prev = None
for _, r in g.iterrows():
    first = NAME[r.dataset] if r.dataset != prev else ""
    if prev is not None and r.dataset != prev: lines.append(r"\addlinespace")
    lines.append(f"{first} & {TLAB[r.tier]} & {pc(r.median_rel_gap)} & {pc(r.max_rel_gap)} & {pc(r.median_rel_gap_of_k_dependent_part)} & {int(r.n_k_used)}/{int(r.n_k_total)} " + r"\\")
    prev = r.dataset
lines += [r"\bottomrule", r"\end{tabular}"]
CAP = (r"Closed-form reducible risk against the empirical $k$-curve. Gap $=|{\rm predicted}-{\rm empirical}|/{\rm empirical}$ of the reducible part "
       r"(risk minus the residual-variance floor); synthetic data have $N{=}60$ benchmarks and rank 4 and $M$ history models. The $k$-dependent part is the gap after removing the offset between predicted and empirical risk at the largest $k$. Summarised over the $k$ at which the empirical reducible part is clearly above zero ($k$ used / $k$ tried). "
       r"Real data: MTEB-Multi and HELM MMLU are fitted in the logit-transformed space. Pre-registered tolerance on the median: 10\% synthetic with fitted parameters, 15\% real data.")
tex = "% generated by figtab-repo figs/table4_theory.py from results/theory_gap.csv; do not edit\n" + \
      "\\begin{table}[t]\n\\caption{" + CAP + "}\n\\label{tab:theory}\n\\centering\\footnotesize\n" + "\n".join(lines) + "\n\\end{table}\n"
os.makedirs(a.out, exist_ok=True)
open(os.path.join(a.out, "table4_theory.tex"), "w").write(tex)
json.dump(dict(table="table4_theory", inputs={f: style.sha(os.path.join(a.results, f)) for f in ("theory_gap.csv", "theory_shape.csv")}),
          open(os.path.join(a.out, "table4_theory.json"), "w"), indent=1)
print(tex)
