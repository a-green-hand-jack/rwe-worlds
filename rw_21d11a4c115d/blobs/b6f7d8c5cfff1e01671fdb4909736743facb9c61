"""Run one (dataset, split, design) cell of the study and save per-model errors.
python3 run_experiment.py <dataset> <split: grouped|grouped_org|random|time> <design: fixed|allrest> <n_draws> <n_part> <out.pkl> [--quick]
Brief revision used: idea-repo `Brief` rev 3 (2026-11-25 16:08 UTC)."""
import sys, os, pickle, time, numpy as np
os.environ.setdefault("OMP_NUM_THREADS", "1"); os.environ.setdefault("OPENBLAS_NUM_THREADS", "1")
sys.path.insert(0, os.path.dirname(__file__))
from bmk.protocol import run, grouped_folds, random_folds, time_folds
ds, split, design, n_draws, n_part, out = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]), int(sys.argv[5]), sys.argv[6]
quick = '--quick' in sys.argv
def flag(name, default=None):
    for a in sys.argv:
        if a.startswith(name + '='): return a.split('=', 1)[1]
    return default
tf = flag('--transform')            # identity | logit
dedup = flag('--dedup')             # rms threshold (standardised units) below which near-duplicate models are dropped (keeps the first of each cluster)
D = np.load(f"{os.path.dirname(__file__)}/../results/data_out/{ds}.npz", allow_pickle=True); X = D['X']; M, N = X.shape
if dedup:   # drop later members of near-duplicate pairs (rms difference of standardised rows < threshold); recorded in the pickle
    Zs = (X - X.mean(0)) / X.std(0); keep = []
    for i in range(M):
        if all(np.sqrt(((Zs[i] - Zs[j]) ** 2).mean()) >= float(dedup) for j in keep): keep.append(i)
    keep = np.array(keep); D = {k: (D[k][keep] if getattr(D[k], 'shape', ()) [:1] == (M,) else D[k]) for k in D.files}; X = D['X']; M, N = X.shape
SEED = {'mteb_eng': 11, 'mteb_multi': 12, 'helm_mmlu': 13, 'helm_lite': 14, 'helm_capabilities': 15, 'llm_union16': 16}[ds] * 1000
if split == 'grouped':
    idx = grouped_folds(D['family'], 10, SEED)
elif split == 'grouped_org':
    idx = grouped_folds(D['family_org'], 10, SEED)
elif split == 'random':
    idx = random_folds(M, 10, SEED)
elif split == 'time':
    folds = time_folds(D['release_ts'])
if split != 'time': folds = [(np.setdiff1d(np.arange(M), f), f) for f in idx]
kmax_allowed = N // 2
k_grid = [k for k in list(range(1, 11)) + [12, 15, 20, 30] if k <= kmax_allowed and k <= int(0.7 * N)]
if design == 'fixed':
    sels = ['random', 'greedyA', 'greedyD', 'maxvar', 'onefactor', 'pivqr', 'leverage', 'kmedoids', 'oracle']
    preds = ['colmean', 'onefactor', 'ridge', 'knn', 'lw', 'fa']
else:
    sels = ['random', 'greedyA']; preds = ['colmean', 'fa', 'ridge']
if '--extra' in sys.argv or '--light' in sys.argv: sels = ['random', 'greedyA']; preds = ['colmean', 'fa', 'ridge']
if '--softimpute' in sys.argv: sels = ['random', 'greedyA']; preds = ['colmean', 'fa', 'softimpute']
if '--bias' in sys.argv: sels = ['random', 'greedyA']; preds = ['colmean', 'fa', 'ridge']
if quick: n_draws, k_grid = 5, [1, 3, 10]
t = time.time()
res = run(X, folds, k_grid, sels, preds, n_draws=n_draws, n_part=n_part, design=design, seed=SEED, verbose=True, track_bias=('--bias' in sys.argv), transform=tf, track_extra=('--extra' in sys.argv))
res.update(dataset=ds, split=split, design=design, k_grid=k_grid, models=D['models'], family=D['family'], family_org=D['family_org'],
           folds=[(a, b) for a, b in folds], n_draws=n_draws, n_part=n_part, seed=SEED, seconds=time.time() - t, brief_revision='idea-repo Brief rev4 (c6be9ad)', transform=tf or 'identity', dedup=dedup)
pickle.dump(res, open(out, 'wb')); print('done', time.time() - t, flush=True)
