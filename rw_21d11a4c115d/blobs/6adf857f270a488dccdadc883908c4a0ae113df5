def setup(width_in, min_pt, height_in=None, aspect=0.62):
    """Fix rcParams so that, at the printed width, the smallest text is >= min_pt."""
    base = max(min_pt, 7.0) if min_pt else 7.0
    mpl.rcParams.update({
        "font.family": "sans-serif", "font.sans-serif": ["DejaVu Sans"],
        "pdf.fonttype": 42, "ps.fonttype": 42,          # embedded TrueType, no Type 3
        "font.size": base, "axes.labelsize": base, "axes.titlesize": base,
        "xtick.labelsize": base, "ytick.labelsize": base, "legend.fontsize": base,
        "figure.titlesize": base,
        "axes.linewidth": 0.6, "lines.linewidth": 1.2, "lines.markersize": 4.0,
        "xtick.major.width": 0.6, "ytick.major.width": 0.6,
        "axes.spines.top": False, "axes.spines.right": False,
        "axes.grid": True, "grid.linewidth": 0.4, "grid.alpha": 0.35,
        "legend.frameon": False, "figure.dpi": 150, "savefig.dpi": 300,
        "figure.constrained_layout.use": True,
    })
    return (width_in, height_in if height_in else width_in * aspect)


def save(fig, name, outdir, sidecar):
    """Write <name>.pdf and <name>.json (what the figure was computed on)."""
    os.makedirs(outdir, exist_ok=True)
    pdf = os.path.join(outdir, name + ".pdf")
    fig.savefig(pdf)
    sidecar = dict(sidecar, figure=name, generated=datetime.date.today().isoformat(),
                   width_in=fig.get_size_inches()[0], height_in=fig.get_size_inches()[1])
    with open(os.path.join(outdir, name + ".json"), "w") as f:
        json.dump(sidecar, f, indent=2, sort_keys=True, default=str)
    plt.close(fig)
    return pdf


def sha(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()[:12]


def plain_log(ax, axis="y"):
    """Log axis with plain decimal tick labels (mathtext exponents print below the type-size floor)."""
    from matplotlib.ticker import FuncFormatter, NullFormatter
    a = ax.yaxis if axis == "y" else ax.xaxis
    a.set_major_formatter(FuncFormatter(lambda v, _: f"{v:g}")); a.set_minor_formatter(NullFormatter())

