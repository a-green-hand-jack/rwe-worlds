"""Appendix tables from experiment-repo result files:
A2 adaptive vs non-adaptive selection (C4); A3 transform choice and robustness rows (C7); A4 predictors on the same draws (C6);
A5 per-benchmark skill (C1). One .tex + .json sidecar each."""
import argparse, os, json
import pandas as pd
import style

p = argparse.ArgumentParser()
p.add_argument("--results", required=True); p.add_argument("--out", default="out")
a = p.parse_args()
R = lambda f: pd.read_csv(os.path.join(a.results, f))
os.makedirs(a.out, exist_ok=True)
DS = ["mteb_eng", "mteb_multi", "helm_mmlu"]
sgn = lambda x, d=3: f"{x:.{d}f}".replace("-", "$-$")
nl = lambda x: sgn(x).replace("0.", ".")  # no leading zero for |x|<1 differences
ci = lambda lo, hi: f"[{nl(lo)}, {nl(hi)}]"


def emit(name, label, cap, body, srcs, tabular="@{}l", extra=None):
    tex = f"% generated by figtab-repo figs/tables_appendix.py from {', '.join(srcs)}; do not edit\n" + \
          "\\begin{table}[t]\n\\caption{" + cap + "}\n\\label{" + label + "}\n\\centering\\footnotesize\\setlength{\\tabcolsep}{3pt}\n" + body + "\n\\end{table}\n"
    open(os.path.join(a.out, name + ".tex"), "w").write(tex)
    json.dump(dict(table=name, inputs={s: style.sha(os.path.join(a.results, s)) for s in srcs}, **(extra or {})),
              open(os.path.join(a.out, name + ".json"), "w"), indent=1)
    return tex


# ---- A2: adaptive selection
ad = R("adaptive.csv"); ad = ad[ad.k.astype(str) == "grid_avg"]
L = [r"\begin{tabular}{@{}lccccc@{}}", r"\toprule",
     r"Predictor & Random & Greedy A & Adaptive A & Adaptive $-$ greedy A & Greedy A $-$ random \\", r"\midrule"]
for ds in DS:
    L.append(r"\multicolumn{6}{@{}l}{\emph{%s}} \\" % style.DATASET_SHORT[ds])
    for pr, pl in (("fa", "factor model"), ("knn", "$k$-NN")):
        d = ad[(ad.dataset == ds) & (ad.predictor == pr)]
        v = lambda m, ver=None, met="rmse": d[(d.method == m) & (d.metric == met) & ((d.versus == ver) if ver else d.versus.isna())].iloc[0]
        g1, g2 = v("adaptiveA", "greedyA", "rmse_gap"), v("greedyA", "random", "rmse_gap")
        L.append(f"{pl} & {v('random').value:.3f} & {v('greedyA').value:.3f} & {v('adaptiveA').value:.3f} & "
                 f"{nl(g1.value)} {ci(g1.ci_lo, g1.ci_hi)} & {nl(g2.value)} {ci(g2.ci_lo, g2.ci_hi)} " + r"\\")
L += [r"\bottomrule", r"\end{tabular}"]
emit("tableA2_adaptive", "tab:adaptive",
     r"Does choosing columns per new model (adaptive A: the greedy A rule re-run on the columns observed for that model) beat one fixed greedy A set? Grid-averaged standardised RMSE "
     r"($k=1..\min(10,N/2)$, grouped $K$-fold, identity scale for all data sets), with family-bootstrap CIs of the paired differences. Negative = first method better.",
     "\n".join(L), ["adaptive.csv"])

# ---- A3: transform choice + robustness
tr = R("transform.csv"); rb = R("robustness.csv")
L = [r"\begin{tabular}{@{}lcccc@{}}", r"\toprule", r"Data & Held-out log-lik., id. / logit & RMSE, id. / logit & Folds for logit & Chosen \\", r"\midrule"]
for ds in DS:
    r = tr[tr.dataset == ds].iloc[0]
    L.append(f"{style.DATASET_SHORT[ds]} & {sgn(r.ll_identity,1)} / {sgn(r.ll_logit,1)} & {r.rmse_identity:.3f} / {r.rmse_logit:.3f} & {int(r.folds_prefer_logit_ll)}/{int(r.n_folds)} & {r.chosen} " + r"\\")
L += [r"\bottomrule", r"\end{tabular}"]
body1 = "\n".join(L)
L = [r"\begin{tabular}{@{}llrrcrc@{}}", r"\toprule", r"Data & Variant & Fam. & Models & Gap [CI] & $C(3)$ & $k^*$ \\", r"\midrule"]
for ds in DS:
    d = rb[(rb.dataset == ds)].copy()
    d["o"] = (~d.variant.str.startswith("main")).astype(int) * 10 + d.split.map({"grouped": 0, "random": 1, "time": 2, "grouped_org": 3})
    d = d.sort_values("o"); first = True
    for _, r in d.iterrows():
        v = r.variant.replace(" (not the chosen one)", "").replace("main (", "chosen: (").replace(" transform", "").replace("near-neighbour removal (rms<0.3), ", "near-duplicates removed, ").replace("family = organisation (grouped_org), ", "family = organisation, ")
        v = v.replace("chosen: (identity)", "chosen identity").replace("chosen: (logit)", "chosen logit")
        if r.split in ("random", "time") : v += f", {r.split} split"
        k = "--" if pd.isna(r["kstar_0.9_lobo_greedyA_fa"]) else f"{int(r['kstar_0.9_lobo_greedyA_fa'])}"
        L.append(f"{style.DATASET_SHORT[ds] if first else ''} & {v} & {int(r.n_families)} & {int(r.n_models)} & {nl(r.gap_greedy_minus_random)} {ci(r.gap_lo, r.gap_hi)} & {r.closure_k3_greedyA_fa:.2f} & {k} " + r"\\")
        first = False
    L.append(r"\addlinespace")
L = L[:-1] + [r"\bottomrule", r"\end{tabular}"]
emit("tableA3_robustness", "tab:robust",
     r"Transform choice and robustness. Top: transform (identity or logit) chosen once per pool by the majority over outer folds of the inner held-out likelihood in the original score space, so the choice used every model of the pool; both are shown. "
     r"Bottom: grid-averaged greedy A $-$ random RMSE gap with family-bootstrap CI (factor model, standardised; negative favours greedy A) and closure $C(3)$ at $k=3$ and $k^*$ at 0.90 (``--'': not reached within the grid) under the chosen setting and under the "
     r"alternative; near-duplicate removal drops models whose nearest neighbour is within RMS 0.3 (standardised); ``family = organisation'' regroups the folds by organisation (Fam. is then the number of organisations) and the bootstrap resamples organisations.",
     body1 + "\n\\medskip\n\n" + "\n".join(L), ["transform.csv", "robustness.csv"])

# ---- A4: predictors on the same draws
pr_ = R("predictors.csv"); pr_ = pr_[pr_.source.str.startswith("main run") & (pr_.split == "grouped")]
PRD = ["colmean", "onefactor", "ridge", "knn", "lw", "fa", "best_simple"]
PL = {"colmean": "column mean", "onefactor": "one-factor", "ridge": "ridge", "knn": "$k$-NN", "lw": "Ledoit-Wolf conditioning", "fa": "factor model", "best_simple": "best simple"}
L = [r"\begin{tabular}{@{}l" + "cc" * len(DS) + r"@{}}", r"\toprule",
     " & " + " & ".join(r"\multicolumn{2}{c}{%s}" % style.DATASET_SHORT[d] for d in DS) + r" \\",
     r"\cmidrule(lr){2-3}\cmidrule(lr){4-5}\cmidrule(lr){6-7}", "Predictor & " + " & ".join("Random & Greedy A" for _ in DS) + r" \\", r"\midrule"]
for pr in PRD:
    row = [PL[pr]]
    for ds in DS:
        for s in ("random", "greedyA"):
            r = pr_[(pr_.dataset == ds) & (pr_.predictor == pr) & (pr_.selector == s)].iloc[0]
            row.append(f"{r.grid_avg_rmse:.3f}")
    L.append(" & ".join(row) + r" \\")
L += [r"\bottomrule", r"\end{tabular}"]
emit("tableA4_predictors", "tab:predictors",
     r"Predictors on the same selected sets: grid-averaged standardised RMSE ($k=1..\min(10,N/2)$, grouped $K$-fold, 200 draws for random selection). Best simple: chosen per fold among one-factor, ridge, "
     r"$k$-NN and Ledoit-Wolf conditioning by grouped 5-fold CV on training rows only.",
     "\n".join(L), ["predictors.csv"])

# ---- A5: per-benchmark skill
sk = R("per_benchmark_skill.csv"); sk = sk[(sk.selector == "greedyA") & (sk.predictor == "fa") & sk.k.isin([1, 3, 10])]
L = [r"\begin{tabular}{@{}lrrcccc@{}}", r"\toprule", r"Data & $k$ & Benchmarks & Median skill [Q1, Q3] & Min & Skill $<0$ (\%) & Skill $<0.5$ (\%) \\", r"\midrule"]
for i, ds in enumerate(DS):
    for k in (1, 3, 10):
        r = sk[(sk.dataset == ds) & (sk.k == k)].iloc[0]
        L.append(f"{style.DATASET_SHORT[ds] if k == 1 else ''} & {k} & {int(r.n_benchmarks)} & {r.skill_median:.2f} [{r.skill_q25:.2f}, {r.skill_q75:.2f}] & {sgn(r.skill_min, 2)} & "
                 f"{100 * r['share_benchmarks_skill_below_0']:.0f} & {100 * r['share_benchmarks_skill_below_0.5']:.0f} " + r"\\")
    if i < 2: L.append(r"\addlinespace")
L += [r"\bottomrule", r"\end{tabular}"]
emit("tableA5_skill", "tab:skill",
     r"Per-benchmark skill of factor model with greedy A: $1-\mathrm{MSE}/\mathrm{MSE}_{\text{column mean}}$ on each held-out benchmark (grouped $K$-fold). Skill 1 is perfect, 0 is no better than the column mean. "
     r"Distribution over the benchmarks of each data set. The column-mean baseline on MTEB-Multi and HELM MMLU is the logit-space mean transformed back (RMSE 1.052 and 1.168 against 1.033 and 1.157 for the arithmetic mean).",
     "\n".join(L), ["per_benchmark_skill.csv"])
print("ok")
