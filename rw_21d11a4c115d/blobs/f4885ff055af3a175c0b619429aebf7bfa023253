"""Main-text sparse-matrix table (review M1, label tab:sparse): all six sparse pools; gap, closure and k* at k = 3 and level 0.9, greedy A vs random.

Pools are separate rows. k* beyond the grid (largest k tried, 20) is printed '>20', never dropped.
"""
import argparse, os, json
import pandas as pd
import style

p = argparse.ArgumentParser()
p.add_argument("--results", required=True); p.add_argument("--out", default="out")
a = p.parse_args()
R = lambda f: pd.read_csv(os.path.join(a.results, f))
sub, gap, clo, ks, info = R("sparse_subsets.csv"), R("sparse_gap.csv"), R("sparse_closure.csv"), R("sparse_kstar.csv"), R("sparse_run_info.csv")
SRCS = ["sparse_subsets.csv", "sparse_gap.csv", "sparse_closure.csv", "sparse_kstar.csv", "sparse_run_info.csv"]
sgn = lambda x: f"{x:.3f}".replace("-", "$-$").replace("0.", ".", 1) if abs(x) < 1 else f"{x:.3f}".replace("-", "$-$")
f2 = lambda x: f'{x:.2f}'.replace('-', '$-$')
ORDER = ["eng_full", "eng_d30", "eng_d50", "eng_d70", "all_d30", "all_d50"]
NAME = {"eng_full": "Eng", "eng_d30": "Eng", "eng_d50": "Eng", "eng_d70": "Eng", "all_d30": "All tasks", "all_d50": "All tasks"}


def kcell(r, ci=False):
    g = int(r.grid_max)
    if r.censored:
        return f"$>${g}"
    return f"{int(r.kstar)} [{int(r.kstar_ci_lo)}, {'$>$' + str(g) if r.kstar_ci_hi > g else int(r.kstar_ci_hi)}]" if ci else str(int(r.kstar))


L = [r"\begin{tabular}{@{}lcccccc@{}}", r"\toprule",
     r" & & & \multicolumn{2}{c}{$C(3)$, FA / pw} & \multicolumn{2}{c}{$k^*$ (0.9), pw} \\",
     r"\cmidrule(lr){4-5}\cmidrule(l){6-7}",
     r"Pool (test models) & Gap [CI], FA & Rel., \% & Greedy & Random & Greedy & Random \\", r"\midrule"]
meta = {}
for s in ORDER:
    sb = sub[sub.subset == s].iloc[0]; ri = info[info.subset == s].iloc[0]
    g = gap[(gap.subset == s) & (gap.predictor == "fa") & (gap.k == 3)].iloc[0]
    c = lambda sel, pr: clo[(clo.subset == s) & (clo.selector == sel) & (clo.predictor == pr) & (clo.k == 3)].closure.iloc[0]
    kk = lambda sel: kcell(ks[(ks.subset == s) & (ks.selector == sel) & (ks.predictor == "pw") & (ks.level == 0.9)].iloc[0], ci=(sel == 'greedyA'))
    gp = gap[(gap.subset == s) & (gap.predictor == "pw") & (gap.k == 3)].iloc[0]
    L.append(f"{NAME[s]} {100 * sb.density:.0f}\,\% ({int(ri.n_tested_models)}) & {sgn(g.gap)} [{sgn(g.ci_lo)}, {sgn(g.ci_hi)}] & {-100 * g.rel_gap_to_random:.0f} / {-100 * gp.rel_gap_to_random:.0f} & "
             f"{f2(c('greedyA','fa'))} / {f2(c('greedyA','pw'))} & {f2(c('random','fa'))} / {f2(c('random','pw'))} & {kk('greedyA')} & {kk('random')} " + r"\\")
    meta[s] = dict(density=float(sb.density), n_tested=int(ri.n_tested_models), gap_k3_fa=float(g.gap), ci=[float(g.ci_lo), float(g.ci_hi)])
L += [r"\bottomrule", r"\end{tabular}"]
CAP = (r"Greedy A vs random selection on the sparse MTEB matrix (identity scale; models with $<30$ observed cells not tested; $k\leq 20$). "
       r"Gap: greedy A minus random at $k=3$, factor model (FA), family-bootstrap CI; Rel.: \% of random error, FA / pw. "
       r"$C(3)$: closure, FA / pw, against the better predictor on all candidates ($C>1$ possible). $k^*$: $C\geq 0.9$, pw; ``$>20$'' not reached.")
tex = "% generated by figtab-repo figs/table_sparse.py from " + ", ".join(SRCS) + "; do not edit\n" + \
      "\\begin{table}[t]\n\\caption{" + CAP + "}\n\\label{tab:sparse}\n\\centering\\footnotesize\\setlength{\\tabcolsep}{3pt}\n" + "\n".join(L) + "\n\\end{table}\n"
os.makedirs(a.out, exist_ok=True)
open(os.path.join(a.out, "table_sparse.tex"), "w").write(tex)
json.dump(dict(table="table_sparse", claim="sparse matrix (review M1)", inputs={s_: style.sha(os.path.join(a.results, s_)) for s_ in SRCS}, rows=meta),
          open(os.path.join(a.out, "table_sparse.json"), "w"), indent=1)
print("ok")
