"""Table A6 (sparse matrix, review M1; appendix, label tab:sparse-k): gap and closure by pool and k = 1, 3, 5, 10, 20, both predictors."""
import argparse, os, json
import pandas as pd
import style

p = argparse.ArgumentParser()
p.add_argument("--results", required=True); p.add_argument("--out", default="out")
a = p.parse_args()
R = lambda f: pd.read_csv(os.path.join(a.results, f))
sub, gap, clo, info = R("sparse_subsets.csv"), R("sparse_gap.csv"), R("sparse_closure.csv"), R("sparse_run_info.csv")
SRCS = ["sparse_subsets.csv", "sparse_gap.csv", "sparse_closure.csv", "sparse_run_info.csv"]
sgn = lambda x: f"{x:.3f}".replace("-", "$-$").replace("0.", ".", 1) if abs(x) < 1 else f"{x:.3f}".replace("-", "$-$")
f2 = lambda x: f'{x:.2f}'.replace('-', '$-$')
ORDER = ["eng_full", "eng_d30", "eng_d50", "eng_d70", "all_d30", "all_d50"]
NAME = {"eng_full": "Eng", "eng_d30": "Eng", "eng_d30": "Eng", "eng_d50": "Eng", "eng_d70": "Eng", "all_d30": "All tasks", "all_d50": "All tasks"}
KS = [1, 3, 5, 10, 20]

L = [r"\begin{tabular}{@{}rcccccc@{}}", r"\toprule",
     r" & \multicolumn{2}{c}{Gap [CI]} & \multicolumn{2}{c}{$C(k)$ greedy A} & \multicolumn{2}{c}{$C(k)$ random} \\",
     r"\cmidrule(lr){2-3}\cmidrule(lr){4-5}\cmidrule(l){6-7}",
     r"$k$ & FA & pw & FA & pw & FA & pw \\"]
meta = {}
for s in ORDER:
    sb = sub[sub.subset == s].iloc[0]; ri = info[info.subset == s].iloc[0]
    L += [r"\midrule", r"\multicolumn{7}{@{}l}{" + f"{NAME[s]}, {100 * sb.density:.0f}\\,\\% observed ({int(sb.n_models)}$\\times${int(sb.n_tasks)}; {int(ri.n_tested_models)} test models)" + r"} \\"]
    for k in KS:
        g = lambda pr: gap[(gap.subset == s) & (gap.predictor == pr) & (gap.k == k)].iloc[0]
        c = lambda sel, pr: clo[(clo.subset == s) & (clo.selector == sel) & (clo.predictor == pr) & (clo.k == k)].closure.iloc[0]
        gf, gp = g("fa"), g("pw")
        L.append(f"{k} & {sgn(gf.gap)} [{sgn(gf.ci_lo)}, {sgn(gf.ci_hi)}] & {sgn(gp.gap)} [{sgn(gp.ci_lo)}, {sgn(gp.ci_hi)}] & "
                 f"{f2(c('greedyA','fa'))} & {f2(c('greedyA','pw'))} & {f2(c('random','fa'))} & {f2(c('random','pw'))} " + r"\\")
        meta[f"{s}_k{k}"] = dict(gap_fa=float(gf.gap), gap_pw=float(gp.gap))
L += [r"\bottomrule", r"\end{tabular}"]
CAP = (r"Greedy A against random selection on the sparse MTEB matrix by pool and number of selected cells $k$ (identity scale; models with fewer than 30 observed cells are not tested). "
       r"Gap: greedy A minus random in standardised RMSE, same predictor (factor model FA; pairwise correlation pw), with the 95\,\% family-bootstrap CI; negative favours greedy A. "
       r"$C(k)$: closure against the lower error of the two predictors conditioning on all candidates, so it can exceed 1 (95\,\% family-bootstrap intervals are at most 0.4 wide for greedy A and up to 1.7 for random selection on All tasks, 50\,\%).")
tex = "% generated by figtab-repo figs/tableA6_sparse_k.py from " + ", ".join(SRCS) + "; do not edit\n" + \
      "\\begin{table}[t]\n\\caption{" + CAP + "}\n\\label{tab:sparse-k}\n\\centering\\footnotesize\\setlength{\\tabcolsep}{3pt}\n" + "\n".join(L) + "\n\\end{table}\n"
os.makedirs(a.out, exist_ok=True)
open(os.path.join(a.out, "tableA6_sparse_k.tex"), "w").write(tex)
json.dump(dict(table="tableA6_sparse_k", claim="sparse matrix (review M1)", inputs={s_: style.sha(os.path.join(a.results, s_)) for s_ in SRCS}, rows=meta),
          open(os.path.join(a.out, "tableA6_sparse_k.json"), "w"), indent=1)
print("ok")
