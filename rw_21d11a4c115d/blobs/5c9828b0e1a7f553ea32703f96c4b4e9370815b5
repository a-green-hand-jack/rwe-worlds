"""Paired family-clustered bootstrap comparisons that the per-run CSVs do not give (B=2000, seed 0; the same resamples within a call).
 (a) shift: grouped-family split vs random split (same models, same pool), and time-forward vs grouped split on the SAME test models
     (the last 45% of the release order), greedy A + factor model, at k=3 and grid-averaged over k=1..min(10,N/2);
 (b) predictor: factor model minus ridge / Ledoit-Wolf / kNN / best simple on the same greedy-A sets (grid-averaged RMSE difference).
Differences are on the RMSE scale (sqrt of the mean per-model MSE); negative = first named is better.
python3 paired_comparisons.py <results_raw> <results>"""
import sys, pickle, numpy as np, pandas as pd, json, os
rawd, resd = sys.argv[1:3]; B = 2000
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
class Boot:
    def __init__(self, fam, seed=0):
        u, self.fi = np.unique(fam, return_inverse=True); self.F = len(u); self.n_f = np.bincount(self.fi, minlength=self.F).astype(float)
        self.cnt = np.random.default_rng(seed).multinomial(self.F, np.ones(self.F) / self.F, size=B).astype(float); self.den = self.cnt @ self.n_f
    def mean(self, e):
        s = np.bincount(self.fi, weights=e, minlength=self.F); return s.sum() / self.n_f.sum(), (self.cnt @ s) / self.den
def ci(b): return float(np.percentile(b, 2.5)), float(np.percentile(b, 97.5))
def load(ds, split): return pickle.load(open(f"{rawd}/{ds}__{split}__fixed.pkl", 'rb'))
def best_simple_arr(R, ds, split, k):
    ch = json.load(open(f"{rawd}/best_simple_{ds}_{split}.json")); arr = np.zeros(len(R['models']))
    for fi, (tr, te) in enumerate(R['folds']): arr[te] = R['err'][('greedyA', ch[str(fi)]['best'], k)][te]
    return arr
rows = []
for ds in ('mteb_eng', 'mteb_multi', 'helm_mmlu'):
    G = load(ds, 'grouped'); Rn = load(ds, 'random'); kg = [k for k in G['k_grid'] if k <= min(10, len(G['k_grid']) and 10)]
    N = np.load(f"{rawd}/../data_out/{ds}.npz", allow_pickle=True)['X'].shape[1]; kg = [k for k in G['k_grid'] if k <= min(10, N // 2)]
    M = len(G['models']); allm = np.arange(M); fam = G['family']
    def cmp(name, a, b, idx, ks):
        """a, b: functions k -> per-model MSE arrays (length M); difference of RMSE on models idx, averaged over ks."""
        bt = Boot(fam[idx]); pa = np.mean([np.sqrt(bt.mean(a(k)[idx])[0]) for k in ks]); pb = np.mean([np.sqrt(bt.mean(b(k)[idx])[0]) for k in ks])
        ba = np.mean([np.sqrt(bt.mean(a(k)[idx])[1]) for k in ks], axis=0); bb = np.mean([np.sqrt(bt.mean(b(k)[idx])[1]) for k in ks], axis=0)
        lo, hi = ci(ba - bb); return (ds, name, 'k=' + str(ks[0]) if len(ks) == 1 else 'grid_avg', len(idx), float(pa), float(pb), float(pa - pb), lo, hi, float((pa - pb) / pb))
    fa = lambda R: (lambda k: R['err'][('greedyA', 'fa', k)])
    for ks in ([3], kg):
        rows.append(cmp('grouped minus random split (greedy A, factor model)', fa(G), fa(Rn), allm, ks))
    T = load(ds, 'time') if ds != 'helm_mmlu' else None
    if T is not None:
        tidx = np.sort(np.concatenate([b for _, b in T['folds']]))
        for ks in ([3], kg):
            rows.append(cmp('time-forward minus grouped split, same test models (greedy A, factor model)', fa(T), fa(G), tidx, ks))
    for other in ('ridge', 'lw', 'knn', 'best_simple'):
        o = (lambda k, other=other: best_simple_arr(G, ds, 'grouped', k)) if other == 'best_simple' else (lambda k, other=other: G['err'][('greedyA', other, k)])
        rows.append(cmp(f'factor model minus {other} (greedy A, grouped)', fa(G), o, allm, kg))
pd.DataFrame(rows, columns=['dataset', 'comparison', 'k', 'n_models', 'rmse_first', 'rmse_second', 'difference', 'ci_lo', 'ci_hi', 'relative_difference']).to_csv(f"{resd}/paired_comparisons.csv", index=False)
print(pd.read_csv(f"{resd}/paired_comparisons.csv").round(3).to_string())
