"""Table A1 (appendix, claim C2): exploratory selector x predictor grid. Grid-averaged gap to random (standardised RMSE, negative = better)
+/- half-width of the family-bootstrap CI (the smallest gap this design could resolve). Bold: Holm-adjusted p < 0.05 within the grid.
The oracle (best of the sampled sets, chooses with the test columns) is a test-leaking bound and gets no p-value."""
import argparse, os, json
import pandas as pd
import style

p = argparse.ArgumentParser()
p.add_argument("--results", required=True); p.add_argument("--out", default="out")
p.add_argument("--split", default="grouped")
a = p.parse_args()
g = pd.read_csv(os.path.join(a.results, "gap.csv"))
g = g[(g.split == a.split) & (g.design == "fixed") & (g.k.astype(str) == "grid_avg")]
DS = ["mteb_eng", "mteb_multi", "helm_mmlu"]
PR = ["fa", "best_simple", "ridge", "knn", "lw", "onefactor"]
SEL = ["greedyA", "greedyD", "kmedoids", "onefactor", "maxvar", "pivqr", "leverage", "oracle"]
PL = {"fa": "FA", "best_simple": "best simple", "ridge": "ridge", "knn": "$k$-NN", "lw": "Ledoit-Wolf", "onefactor": "one-factor"}
SL = dict(style.SHORT_LABELS, greedyA="greedy A", oracle="oracle (test-leaking)")
fmt = lambda x: f"{x:.3f}".replace("0.", ".").replace("-.", "$-$.")
lines = [r"\begin{tabular}{@{}l" + "r" * len(PR) + r"@{}}", r"\toprule", "Selector & " + " & ".join(PL[x] for x in PR) + r" \\"]
for ds in DS:
    lines += [r"\midrule", r"\multicolumn{%d}{@{}l}{\emph{%s}} \\" % (len(PR) + 1, style.DATASET_SHORT[ds])]
    for s in SEL:
        cells = []
        for pr in PR:
            r = g[(g.dataset == ds) & (g.predictor == pr) & (g.selector == s)].iloc[0]
            c = f"{fmt(r.gap)}$\\pm${r.ci_halfwidth:.3f}".replace("0.", ".")
            if s != "oracle" and r.holm_p < 0.05:
                c = r"\textbf{" + c + "}"
            cells.append(c)
        lines.append(f"{SL[s]} & " + " & ".join(cells) + r" \\")
lines += [r"\bottomrule", r"\end{tabular}"]
CAP = (r"Exploratory grid: gap to random draws (mean over the grid $k=1..\min(10,N/2)$, standardised RMSE, grouped $K$-fold; negative = better than random) $\pm$ half-width of the "
       r"family-clustered bootstrap CI, which is the smallest gap this design resolves. Bold: Holm-adjusted two-sided $p<0.05$ across the grid (either sign). The oracle picks the best of the sampled sets using the test columns and is a bound, not a method. "
       r"The pre-registered comparison is greedy A with the factor model (FA).")
tex = "% generated by figtab-repo figs/tableA1_exploratory.py from results/gap.csv; do not edit\n" + \
      "\\begin{table}[t]\n\\caption{" + CAP + "}\n\\label{tab:grid}\n\\centering\\footnotesize\\setlength{\\tabcolsep}{2.5pt}\n" + "\n".join(lines) + "\n\\end{table}\n"
os.makedirs(a.out, exist_ok=True)
open(os.path.join(a.out, "tableA1_exploratory.tex"), "w").write(tex)
json.dump(dict(table="tableA1_exploratory", split=a.split, design="fixed", inputs={"gap.csv": style.sha(os.path.join(a.results, "gap.csv"))}),
          open(os.path.join(a.out, "tableA1_exploratory.json"), "w"), indent=1)
print(tex[:3000])
