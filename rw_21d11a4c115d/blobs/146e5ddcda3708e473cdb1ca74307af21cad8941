"""Step 2: the analysis datasets (dense matrices) with family keys and time proxy -> data_out/<name>.npz and datasets audit inputs.
Family rules:
  MTEB: org = text before '__'; base-name tokens (split on - _ . space) lower-cased with size/version/variant tokens removed;
        family = org + first two remaining tokens.  Coarser variant 'family_org' = org only (robustness).
  HELM MMLU: first word of the model name, with Mixtral->Mistral, 'Amazon Nova'->Nova, 'Command R'->Command, 'Yi Large'->Yi.
Time proxy: MTEB release_date from each result's model_meta.json (100% coverage in both pools); first-commit time kept but is bulk-dominated.
Run: python3 build_datasets.py <parsed_dir> <out_dir>"""
import sys, re, json, numpy as np, pandas as pd
d, out = sys.argv[1:3]
DROP = re.compile(r"^(base|large|small|xs|s|m|l|xl|xxl|mini|tiny|micro|medium|nano|light|instruct|chat|turbo|long|en|unsupervised|"
                  r"v\d+(\.\d+)*|\d+(\.\d+)?[bmk]?|\d+[bm]|r\d|cased|uncased|distil\w*|multilingual|mt|nlu|sts|all|supervised|mntp|\d+x\d+b)$")
def mteb_family(model):
    org, _, name = model.partition("__")
    toks = [t for t in re.split(r"[-_. ]+", name.lower()) if t]
    rest = [t for t in toks if not DROP.match(t)] or toks[:1]
    return org.lower() + "|" + "-".join(rest[:2]), org.lower()
mi = pd.read_parquet(f"{d}/mteb_models.parquet")
for name in ("mteb_eng_pool", "mteb_dense_pool"):
    P = pd.read_parquet(f"{d}/{name}.parquet"); ms = list(P.index)
    fam = [mteb_family(m) for m in ms]
    rel = pd.Series(pd.to_datetime(mi.loc[ms, "release_date"]).dt.as_unit("s").astype("int64"))  # seconds since epoch
    ds = "mteb_eng" if "eng" in name else "mteb_multi"
    np.savez(f"{out}/{ds}.npz", X=P.values.astype(float), models=np.array(ms), tasks=np.array(P.columns), family=np.array([f[0] for f in fam]),
             family_org=np.array([f[1] for f in fam]), release_ts=rel.values, n_params=mi.loc[ms, "n_parameters"].values.astype(float),
             first_commit_ts=mi.loc[ms, "first_commit_ts"].values.astype(float))
    print(ds, P.shape, "families", len(set(f[0] for f in fam)), "orgs", len(set(f[1] for f in fam)))
h = np.load(f"{d}/helm_mmlu.npz", allow_pickle=True)
def helm_family(n):
    w = n.split()[0].split("-")[0]
    if n.startswith("Amazon Nova"): return "nova"
    if n.startswith("Command R"): return "command"
    return {"mixtral": "mistral"}.get(w.lower(), w.lower())
fam = [helm_family(m) for m in h["models"]]
np.savez(f"{out}/helm_mmlu.npz", X=h["X"], n_eval=h["n_eval"], models=h["models"], tasks=h["tasks"], family=np.array(fam), family_org=np.array(fam))
print("helm_mmlu", h["X"].shape, "families", len(set(fam)), sorted(set(fam)))
