"""Table 3 (claim C5): coherence, how much greedy A gains over random in the closed-form reducible risk, and the sampled
submodularity ratio, per fitted-model family (real: every grouped-fold training fit x column partition; synthetic: coherence controlled).

All entries are medians over the fits of the data set (n in the table); coherence also shows min-max. gamma-hat is a sampled
minimum, i.e. an upper bound on the true submodularity ratio, so 1-exp(-gamma-hat) is a heuristic and not a guarantee.
"""
import argparse, os, json
import pandas as pd
import style

p = argparse.ArgumentParser()
p.add_argument("--results", required=True); p.add_argument("--out", default="out")
a = p.parse_args()
c = pd.read_csv(os.path.join(a.results, "coherence.csv"))
KS = [1, 3, 10]
ORDER = ["mteb_eng", "mteb_multi", "helm_mmlu", "synthetic_spiky0", "synthetic_spiky1", "synthetic_spiky2", "synthetic_spiky3"]
NAME = dict(style.DATASET_SHORT, **{f"synthetic_spiky{i}": f"Synthetic, level {i}" for i in range(4)})
lines = [r"\begin{tabular}{@{}lcccccccc@{}}", r"\toprule",
         r" & & & & \multicolumn{3}{c}{Gap to random (\%) at $k=$} & & \\ \cmidrule(lr){5-7}",
         r"Data & Fits & Rank & Coherence $\mu$ [min, max] & " + " & ".join(str(k) for k in KS) + r" & $\hat\gamma$ & $1-e^{-\hat\gamma}$ \\", r"\midrule"]
meta = {}
for i, ds in enumerate(ORDER):
    d = c[c.dataset == ds]
    per_fit = d.drop_duplicates("fit_id")
    gaps = [100 * d[d.k == k].gap_random_greedy.median() for k in KS]
    mu = per_fit.coherence
    lines.append(f"{NAME[ds]} & {per_fit.shape[0]} & {int(per_fit['rank'].median())} & {mu.median():.1f} [{mu.min():.1f}, {mu.max():.1f}] & "
                 + " & ".join(f"{g:.0f}" for g in gaps) + f" & {per_fit.gamma_hat.median():.2f} & {per_fit.greedy_bound_heuristic.median():.2f} " + r"\\")
    if ds == "helm_mmlu":
        lines.append(r"\addlinespace")
    meta[ds] = dict(n_fits=int(per_fit.shape[0]), gaps_pct=dict(zip(KS, gaps)))
lines += [r"\bottomrule", r"\end{tabular}"]
CAP = (r"When random selection is close to greedy A in the closed-form reducible risk. Coherence $\mu=(|C|/r)\max_j \ell_j$ is the largest leverage of the "
       r"noise-whitened loadings over the candidate columns $C$; gap is $({\rm random}-{\rm greedy})/{\rm random}$ of the reducible risk (random: mean of 100 draws), "
       r"median over fits (rank: of each fitted factor model; MTEB-Multi and HELM MMLU are fitted in the logit-transformed space); $\hat\gamma$ is the smallest submodularity ratio found by sampling (an upper bound on the true ratio), so $1-e^{-\hat\gamma}$ is a heuristic, "
       r"not a guarantee. Synthetic: $N=60$ benchmarks, rank 4, loadings concentrated on a few benchmarks at levels 0--3.")
tex = "% generated by figtab-repo figs/table3_coherence.py from results/coherence.csv; do not edit\n" + \
      "\\begin{table}[t]\n\\caption{" + CAP + "}\n\\label{tab:coherence}\n\\centering\\footnotesize\\setlength{\\tabcolsep}{3pt}\n" + "\n".join(lines) + "\n\\end{table}\n"
os.makedirs(a.out, exist_ok=True)
open(os.path.join(a.out, "table3_coherence.tex"), "w").write(tex)
json.dump(dict(table="table3_coherence", inputs={"coherence.csv": style.sha(os.path.join(a.results, "coherence.csv"))}, panels=meta),
          open(os.path.join(a.out, "table3_coherence.json"), "w"), indent=1)
print(tex)
