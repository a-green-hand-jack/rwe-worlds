"""Table 1 (claim C0): the data regimes. Reads results/datasets.csv; writes a booktabs table (8 pt)."""
import argparse, os, json
import pandas as pd
import style

p = argparse.ArgumentParser()
p.add_argument("--results", required=True); p.add_argument("--out", default="out")
a = p.parse_args()
d = pd.read_csv(os.path.join(a.results, "datasets.csv")).set_index("dataset")
order = ["mteb_eng", "mteb_multi", "helm_mmlu"]
d = d.loc[order]
na = "--"


def row(label, f, cols=order):
    cells = []
    for ds in cols:
        try:
            v = d.loc[ds, f[0]] if isinstance(f, tuple) else None
        except KeyError:
            v = None
        cells.append(na if v is None or pd.isna(v) else f[1](d.loc[ds]))
    return label + " & " + " & ".join(cells) + r" \\"


R = lambda x: f"{x:.0f}"
rows = [
    ("Models $\\times$ benchmarks, dense pool", ("dense_pool_models", lambda r: f"{int(r.dense_pool_models)} $\\times$ {int(r.dense_pool_tasks)}")),
    ("Models $\\times$ benchmarks, all", ("n_models", lambda r: f"{int(r.n_models)} $\\times$ {int(r.n_tasks)}")),
    ("Density before pooling", ("density", lambda r: f"{r.density:.2f}")),
    ("Families in pool (organisations)", ("n_families", lambda r: f"{int(r.n_families)} ({int(r.n_orgs)})")),
    ("Rank $r_{\\rm eff}$ (arg-max)", ("r_eff", lambda r: f"{int(r.r_eff)} ({int(r.r_argmax)})")),
    ("Variance share of factor 1 / factor 2", ("first_factor_share", lambda r: f"{r.first_factor_share:.2f} / {r.second_factor_share:.2f}")),
    ("Participation ratio", ("participation_ratio", lambda r: f"{r.participation_ratio:.1f}")),
    ("Near-duplicate share (RMS $<0.01$)", ("near_dup_share_rms_lt_0p01", lambda r: f"{r.near_dup_share_rms_lt_0p01:.3f}")),
    ("Binomial floor (share of variance)", ("binomial_noise_floor_std_units", lambda r: f"{r.binomial_noise_floor_std_units:.3f}")),
    ("Median release, pool / other", ("pool_median_release", lambda r: f"{r.pool_median_release[:7]} / {r.rest_median_release[:7]}")),
    ("Median params (M), pool / other", ("pool_median_params_M", lambda r: f"{r.pool_median_params_M:.0f} / {r.rest_median_params_M:.0f}")),
    ("Other models' mean score (pool SD)", ("rest_mean_z", lambda r: f"{r.rest_mean_z:+.2f}")),
]
lines = [r"\begin{tabular}{@{}lccc@{}}", r"\toprule",
         "& " + " & ".join(style.DATASET_SHORT[x] for x in order) + r" \\", r"\midrule"]
lines += [row(l, f) for l, f in rows]
lines += [r"\bottomrule", r"\end{tabular}"]
bc = pd.read_csv(os.path.join(a.results, "bound_check.csv"))
bc = bc[bc.rank_source == "median_fold_rank"].drop_duplicates("dataset").set_index("dataset").r
FOLD_RANKS = " / ".join(str(int(bc[x])) for x in order)
CAPTION = (r"Dense pool: the complete block (no missing cell) used by every experiment (HELM MMLU: 57 subjects of one benchmark). "
           r"$r_{\rm eff}$: smallest rank within one s.e. of the best held-out likelihood, chosen on the whole pool (arg-max in brackets; median over outer folds: " + FOLD_RANKS + r"). "
           r"\emph{Other models}: MTEB models outside the pool (score: with $\ge10$ pool benchmarks).")
os.makedirs(a.out, exist_ok=True)
tex = "\n".join(lines) + "\n"
float_tex = "\\begin{table}[t]\n\\caption{" + CAPTION + "}\n\\label{tab:datasets}\n\\centering\\footnotesize\\setlength{\\tabcolsep}{3pt}\n" + tex + "\\end{table}\n"
open(os.path.join(a.out, "table1_datasets.tex"), "w").write(
    "% generated by figtab-repo figs/table1_datasets.py from results/datasets.csv; do not edit\n" + float_tex)
json.dump(dict(table="table1_datasets", inputs={f: style.sha(os.path.join(a.results, f)) for f in ("datasets.csv", "bound_check.csv")}),
          open(os.path.join(a.out, "table1_datasets.json"), "w"), indent=1)
print(float_tex)
