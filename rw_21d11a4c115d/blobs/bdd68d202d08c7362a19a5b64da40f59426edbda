"""Sparse-matrix run: python3 run_sparse.py <subset> <n_draws> <n_part> <out.pkl> [--quick]
subset = name of results/data_out/sparse_<subset>.npz (build_sparse_subsets.py).  Grouped (family-held-out) 10-fold protocol of bmk/sparse.py."""
import sys, os, pickle, time, numpy as np
os.environ.setdefault("OMP_NUM_THREADS", "1"); os.environ.setdefault("OPENBLAS_NUM_THREADS", "1")
sys.path.insert(0, os.path.dirname(__file__))
from bmk.sparse import run_sparse
ds, n_draws, n_part, out = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), sys.argv[4]
D = np.load(f"{os.path.dirname(__file__)}/../results/data_out/sparse_{ds}.npz", allow_pickle=True); X = D['X']
k_grid = [1, 2, 3, 4, 5, 6, 8, 10, 12, 15, 20]
if '--quick' in sys.argv: n_draws, n_part, k_grid = 3, 1, [1, 3, 10]
SEED = 21000 + sum(map(ord, ds))
t = time.time(); res = run_sparse(X, D['family'], k_grid, n_draws=n_draws, n_part=n_part, seed=SEED)
res.update(dataset=ds, k_grid=k_grid, models=D['models'], tasks=D['tasks'], family=D['family'], family_org=D['family_org'], n_draws=n_draws, n_part=n_part, seed=SEED, seconds=time.time() - t)
pickle.dump(res, open(out, 'wb')); print('done', time.time() - t)
