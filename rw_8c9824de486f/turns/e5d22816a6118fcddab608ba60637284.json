=True)\n\ndef n_heldout():\n    out = {}\n    for s in (\"G\", \"T\", \"S\"):\n        if s == \"S\": a, tr, te = strength_split(Y); out[s] = te\n        else: out[s] = [x for f in make_splits(mods)[s] for x in f[2]] if s == \"G\" else make_splits(mods)[\"T\"][0][2]\n    return out\n\nHO = n_heldout()\nkmax = max(K_GRID)\ncurves, contrasts, kst, decs = [], [], [], []\nfor tag in tags:\n    d = load(tag); d[\"org\"] = org[d.model.values]\n    fl = d[d.rule == \"floor\"].set_index([\"split\", \"model\", \"k\"])\n    for s in sorted(d.split.unique()):\n        ds = d[d.split == s]; ho = set(HO[s]); n_ho = len(ho)\n        entering = {k: set(ds[(ds.rule == \"floor\") & (ds.k == k)].model) for k in K_GRID}\n        fixed = entering[kmax] if entering[kmax] else set()\n        for sub in ([\"fixed\", \"all\"] if len(fixed) >= 5 else [\"all\"]):\n\nShell cwd was reset to /hutian/repo\n```", "exit": null}}}, {"id": "f8db297b-f949-579c-bf08-b4475b43f065", "at": 1795732453.31411, "clock": "host", "stream": "runner", "sequence": 32689, "layer": "worker", "category": "usage", "kind": "session.usage", "role": "figtab-repo", "actor": "figtab-repo", "execution_id": "e5d22816a6118fcddab608ba60637284", "trust": "agent-reported", "outcome": null, "label": "usage", "repository": null, "flags": [], "causes": [], "summary": "context usage"}, {"id": "7749390b-3a43-57ba-8e85-2ca048a931e4", "at": 1795732453.3214047, "clock": "host", "stream": "runner", "sequence": 32690, "layer": "worker", "category": "message", "kind": "session.session/request_permission", "role": "figtab-repo", "actor": "figtab-repo", "execution_id": "e5d22816a6118fcddab608ba60637284", "trust": "agent-reported", "outcome": null, "label": "message", "repository": null, "flags": [], "causes": [], "summary": "session/request_permission"}, {"id": "66963239-f09d-50cd-aeaa-c33a28c948e3", "at": 1795732453.336281, "clock": "host", "stream": "runner", "sequence": 32691, "layer": "worker", "category": "message", "kind": "session.re