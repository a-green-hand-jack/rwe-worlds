"""Collect the per-fold margins (stage A) into prereg/delta_by_fold.csv. Run and commit BEFORE stage B.
usage: python 06_delta_table.py <work_dir> <out_csv>"""
import sys, os, glob, pickle, pandas as pd, numpy as np
work, out = sys.argv[1:3]
tasks = pd.read_csv(os.path.join(os.path.dirname(__file__), "..", "data", "tasks.csv")).task.values
rows = []
for f in sorted(glob.glob(os.path.join(work, "state", "*.pkl"))):
    st = pickle.load(open(f, "rb"))
    for j, t in enumerate(tasks):
        rows.append(dict(split=st["split"], fold=st["fold"], task=t, n_train_models=int((st["train"]).size), gap_raw=st["gap"][j],
                         floor_raw=st["floor"][j], delta_raw=st["delta"][j], loo_rank=st["best_rank"]["loo"], sd_train=st["sd"][j]))
df = pd.DataFrame(rows); df.to_csv(out, index=False, float_format="%.5g")
print(df.groupby(["split", "fold"]).agg(delta_mean=("delta_raw", "mean"), floor_mean=("floor_raw", "mean"), gap_mean=("gap_raw", "mean"), rank=("loo_rank", "first")))
