"""Fig. 3: theory vs measurement. (a, b) synthetic data with known truth: measured error of S6+P5 against the T1 prediction
at fitted parameters, per k; (c) the real matrix on the common target set: measured MSE of S6+P5 against the T1 prediction
(design term + floor term), and the measured and predicted floor. The estimation term against M with its c/M fit is its own
figure (fig3c_estimation_vs_M.pdf, appendix), written beside OUT.pdf.

usage: python3 -m figtab.make_fig3 RESULTS_DIR OUT.pdf [SUBSET=fixed]     (repo root as cwd)
Reads RESULTS_DIR/{synth/synth_summary.csv, synth/synth_estimation_fit.csv, ct_decomposition.csv, floor_misfit_summary.csv, ct_run_meta.json}.
"""
import sys, pathlib
import numpy as np, pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.ticker import FixedLocator, FuncFormatter
from figtab import style, provenance, check_pdf

res = pathlib.Path(sys.argv[1]); out = sys.argv[2]
subset = sys.argv[3] if len(sys.argv) > 3 else "fixed"
style.apply(); C = style.COLORS
syn = pd.read_csv(res / "synth/synth_summary.csv")
fit = pd.read_csv(res / "synth/synth_estimation_fit.csv")
dec = pd.read_csv(res / "ct_decomposition.csv")
fms = pd.read_csv(res / "floor_misfit_summary.csv")
KT = [1, 2, 3, 5, 8, 12, 20, 32, 50, 80, 109]
lab = lambda ax: (ax.set_xscale("log"), ax.xaxis.set_major_locator(FixedLocator([1, 2, 3, 5, 8, 12, 20, 32, 50, 80, 109])),
                  ax.xaxis.set_major_formatter(FuncFormatter(lambda v, _: f"{v:g}")), ax.minorticks_off())

fig = plt.figure(figsize=(style.VENUE["text_in"], 3.2), constrained_layout=True)
gs = fig.add_gridspec(2, 2, width_ratios=[1, 1.35])
a, b, d = fig.add_subplot(gs[0, 0]), fig.add_subplot(gs[1, 0]), fig.add_subplot(gs[:, 1])
M_SEP, M_DEC = 320, 240

def synth_panel(axp, regime, M, letter, title, true_line):
    s = syn[(syn.regime == regime) & (syn.level == "L0_correct") & (syn.M == M)].sort_values("k")
    axp.errorbar(s.k, s.mse_S6, yerr=s.mse_S6_se, color=C["designed"], marker="o", capsize=1.5, elinewidth=0.6, label="measured, S6+P5")
    axp.plot(s.k, s.t1_fit, color=C["theory"], ls="-.", label="T1, fitted parameters")
    if true_line:
        axp.plot(s.k, s.t1_true, color=C["theory"], ls=":", label="T1, true parameters")
    lab(axp); axp.set_xticks([1, 3, 8, 20, 32]); axp.set_xlim(0.85, 38)
    axp.set_xlabel(f"{letter} k;  {title}, $M$ = {M}"); axp.set_ylabel("squared error (standardised)")
    axp.legend(loc="upper right", handlelength=1.8, labelspacing=0.2)
    return s

sa = synth_panel(a, "separated", M_SEP, "(a)", "separated factors", False)
sb = synth_panel(b, "decaying", M_DEC, "(b)", "decaying spectrum", True)

# (d) real matrix, common target set
r = dec[(dec.split == "G") & (dec.subset == subset)].sort_values("k")
fl = fms[fms.holdout == "G"].iloc[0]
d.fill_between(r.k, r.measured_lo90, r.measured_hi90, color=C["designed"], alpha=0.22, lw=0)
d.plot(r.k, r.measured, color=C["designed"], marker="o", label="measured, S6+P5")
d.plot(r.k, r.noise_pred + r.design_pred, color=C["theory"], ls="-.", label="T1 (design + floor term)")
d.axhline(fl.floor_mse, color=C["floor"], lw=0.8, ls="--"); d.axhline(fl.noise_pred, color=C["theory"], lw=0.8, ls=":")
d.text(1.0, fl.floor_mse + 2.0, "measured floor", ha="left", va="bottom")
d.text(1.0, fl.noise_pred + 2.0, "T1 floor term", ha="left", va="bottom", color=C["theory"])
lab(d); d.set_xlim(0.85, 130); d.set_ylim(0, None)
d.set_xlabel(f"(c) k;  MTEB, held-out groups ({int(r.n_models.iloc[0])} models)")
d.set_ylabel("squared error (raw points\u00b2)")
d.legend(loc="upper right", handlelength=1.8, labelspacing=0.2)
d.text(0.97, 0.56, f"floor at k = 20:\nmeasured / T1 = {fl.ratio_floor_to_pred:.1f}", transform=d.transAxes, ha="right", va="center")
fig.savefig(out)

# fig3c: estimation term against M (appendix)
out_c = str(pathlib.Path(out).with_name('fig3c_estimation_vs_M.pdf'))
figc, c = plt.subplots(1, 1, figsize=(style.VENUE['half_in'] * 1.35, 2.0))
sc = syn[(syn.regime == "separated") & (syn.level == "L0_correct")]
ks = [1, 5, 20]; cols = {1: C["other2"], 5: C["designed"], 20: C["other"]}
Mg = np.array([30, 800])
for k in ks:
    s = sc[sc.k == k].sort_values("M")
    c.errorbar(s.M, s.est_term, yerr=s.est_term_se, color=cols[k], marker="o", ls="none", capsize=1.5, elinewidth=0.6, label=f"k = {k}")
    cc = float(fit.loc[fit.k == k, "c_in_c_over_M"].iloc[0])
    c.plot(Mg, cc / Mg, color=cols[k], lw=0.8, ls="-")
c.set_xscale("log"); c.set_yscale("log")
c.set_xticks([40, 80, 160, 320, 640]); c.set_xticklabels(["40", "80", "160", "320", "640"]); c.minorticks_off()
c.yaxis.set_major_locator(FixedLocator([0.003, 0.01, 0.03, 0.1])); c.yaxis.set_major_formatter(FuncFormatter(lambda v, _: f"{v:g}"))
c.set_xlim(32, 800)
c.set_xlabel("training models $M$;  separated factors"); c.set_ylabel("estimation term (standardised)")
sl = fit.loglog_slope
c.text(0.97, 0.97, f"lines: $c/M$ fits;\nlog-log slope {sl.min():.2f} to {sl.max():.2f}\n(over k = 1 to 32)".replace("-", "\u2212"), transform=c.transAxes, ha="right", va="top")
c.legend(loc="lower left", handlelength=1.0, labelspacing=0.2)

figc.savefig(out_c)

used = [res / f for f in ("synth/synth_summary.csv", "synth/synth_estimation_fit.csv", "ct_decomposition.csv", "floor_misfit_summary.csv", "ct_run_meta.json")]
provenance.write(out_c, used[:2], {"panels": {"c": "synthetic, separated, correct model, k=1,5,20; line = c/M with c from synth_estimation_fit.csv"},
    "n_seeds_synthetic": float(syn.n_seeds.iloc[0]), "script": "figtab/make_fig3.py"}, root=res)
provenance.write(out, used, {
    "panels": {"a": f"synthetic, separated, correct model L0, M={M_SEP}", "b": f"synthetic, decaying, correct model L0, M={M_DEC}",
               "c": f"real MTEB, common target set, split G, subset {subset}"},
    "n_seeds_synthetic": float(syn.n_seeds.iloc[0]), "n_models_in_real_panel": int(r.n_models.iloc[0]), "n_groups_in_real_panel": int(r.n_groups.iloc[0]),
    "script": "figtab/make_fig3.py"}, root=res)
print(check_pdf.check(out)); print(check_pdf.check(out_c))
