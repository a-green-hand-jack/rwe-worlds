#!/bin/bash
# usage: 31_scope_ct_all.sh <data_dir> <work_dir> <out_dir>  (scope sweeps on the common target set, G folds 0-3, S0+S6, 20 splits)
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 MC_KGRID=1,2,3,5,8,12,20,32 MC_RANKS=1,2,4,8,16
cd "$(dirname "$0")"
D=$1; W=$2; O=$3
( for c in ref M50 M25 dens70 dens50 dens30 logit suite types; do for f in 0 1 2 3; do echo "$c $f"; done; done ) | xargs -P ${NP:-4} -L 1 sh -c "python3 -u 30_scope_ct.py $D $W \$0 \$1 && python3 -u 21_eval_ct.py $D $W \$0 \$1 $O S0,S6 sc 20 32"
echo HUTIAN_WAKE: scope ct done
