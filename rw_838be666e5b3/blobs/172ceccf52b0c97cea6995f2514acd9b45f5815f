NOM = CFG["nominal"]


def esc(s):
    return str(s).replace("_", "\\_").replace("&", "\\&").replace("%", "\\%")


def fnum(x, d=3):
    """Three significant figures (datasets are in their own units: 0.03 to 13000)."""
    if pd.isna(x):
        return "--"
    v = float(f"{x:.{d}g}")
    if abs(v) >= 1e6:         # degenerate intervals (bootstrap-t at tiny n): mantissa and exponent
        m, e = f"{v:.1e}".split("e")
        return f"${m}\\!\\times\\!10^{{{int(e)}}}$"
    return f"{v:.0f}" if abs(v) >= 10 ** (d - 1) else f"{v:.{max(0, d - 1 - int(np.floor(np.log10(abs(v)))))}f}" if v else "0"


def cov_cell(r):
    if pd.isna(r.coverage):
        return "--"
    s = f"{100*r.coverage:.1f}\\,[{100*r.cov_lo:.1f},{100*r.cov_hi:.1f}]"
    return s if r.valid == 1 else s + "$^\\dagger$"


def ratio_cell(r):
    if r.method == "ppipp":
        return "1"
    if pd.isna(r.ratio_lo):       # floor: model-based predicted ratio, no paired CI
        return f"{r.ratio_vs_ppipp:.3f}\\,(predicted)"
    return f"{r.ratio_vs_ppipp:.3f}\\,[{r.ratio_lo:.3f},{r.ratio_hi:.3f}]"


def unclip_cell(r):
    if r.method == "ppipp_unclip":
        return "1"
    if pd.isna(r.get("ratio_vs_unclip")) or pd.isna(r.get("ratio_unclip_lo")):
        return "--"
    return f"{r.ratio_vs_unclip:.3f}\\,[{r.ratio_unclip_lo:.3f},{r.ratio_unclip_hi:.3f}]"


def body(df, label_of, unclip=False):
    lines = []
    for (d, _n), g in df.groupby(["dataset", "n"], sort=True):
        ok = g[(g.valid == 1) & (g.method != "floor")]   # the floor is a bound, never a winner
        best = ok.width_mean.min() if len(ok) else np.nan
        first = True
        order = {m: i for i, m in enumerate(style.METHODS)}
        for _, r in g.assign(_o=g.method.map(order)).sort_values(["tier", "_o"]).iterrows():
            w = fnum(r.width_mean)
            if r.valid == 1 and r.method != "floor" and r.width_mean == best:
                w = f"\\textbf{{{w}}}"
            name = f"{esc(nice(d))} ($n$={int(r.n)})" if first else ""
            lines.append(f"{name} & {esc(label_of(r))} & {w} & {cov_cell(r)} & {ratio_cell(r)}" + (f" & {unclip_cell(r)}" if unclip else "") + " \\\\")
            first = False
        lines.append("\\midrule")
    return lines[:-1]


def wrap(lines, cols="llrrr", head="Dataset & Method & Width & Coverage (\\%) [Wilson 95\\%] & Width / PPI++ [95\\% CI]", tight=False):
    """longtable: the appendix tables run over a page (repeat the header; place in single-column mode or \\onecolumn)."""
    out = ["\\begin{longtable}{" + cols + "}", "\\toprule", head + " \\\\", "\\midrule", "\\endhead", *lines, "\\bottomrule",
           "\\end{longtable}"]
    return ["{\\scriptsize\\setlength{\\tabcolsep}{2pt}" if tight else "{\\setlength{\\tabcolsep}{2pt}", *out, "}"]


SHORT = {"calib_spline": "Calib. (spline)", "calib_iso": "Calib. (isotonic)", "select": "Selected",
         "pooled_linear": "Pooled linear", "labels_cp": "Labels (C-P)", "labels_z": "Labels (z)"}      # appendix table: narrow method column


def write(name, lines):
    p = style.outdir("tables") / f"{name}.tex"
    p.write_text("\n".join(lines) + "\n")
    print("wrote", p)


def label(r):
    base = style.method_style(r.method)[0]
    return base if r.construction in ("wald", None) or pd.isna(r.construction) else f"{base} ({r.construction})"


CLS = {"no gain": "none", "small / undecided": "small", "gain": "gain"}


def ratio_block(t, arms):
    """Second block of tab_main: paired ratios to package PPI++, to the unclipped PPI++ (headline arm), classes (pre-fixed
    margin, headline.csv) and the floor in both units. B5 is added when it is drawn (complete for every dataset with X)."""
    hl = schema.load("headline.csv").set_index(["dataset", "tier", "n"])
    useB5 = any(a[1] == "select_x" for a in arms)
    rows = []
    for d, g in t.groupby("dataset", sort=True):
        n = int(g.n.iloc[0])
        def rc(m, tier="T1"):
            r = g[(g.method == m) & (g.tier == tier)]
            return None if r.empty else r.iloc[0]
        def fmt(r):
            return "--" if r is None else f"{r.ratio_vs_ppipp:.3f} [{r.ratio_lo:.3f},{r.ratio_hi:.3f}]"
        h = hl.loc[(d, "T1", n)]
        sel = rc("select")
        if abs(sel.ratio_vs_ppipp - h.ratio) > 5e-4:
            sys.exit(f"headline.csv and cells.csv disagree on the selected arm at {d} n={n}: {h.ratio} vs {sel.ratio_vs_ppipp}")
        cells_ = [fmt(rc("ppipp_unclip")), fmt(sel) + ("" if sel.valid == 1 else "$^\\dagger$"), CLS[h.classification],
                  f"{h.ratio_vs_unclip:.3f} [{h.ratio_unclip_lo:.3f},{h.ratio_unclip_hi:.3f}]", CLS[h.classification_vs_unclip],
                  f"{h.ratio_vs_valid_baseline:.3f} [{h.ratio_valid_lo:.3f},{h.ratio_valid_hi:.3f}]", {"package": "P", "unclipped": "U"}[h.baseline_used] + ("" if h.baseline_valid == 1 else "$^\\ddagger$"),
                  CLS[h.classification_vs_valid_baseline], f"{h.floor_ratio:.3f}", f"{h.floor_ratio_measured:.3f}"]
        if useB5:
            b = rc("select_x", "T2")
            h2 = hl.loc[(d, "T2", n)] if (d, "T2", n) in hl.index else None
            cells_ += ["--", "--"] if b is None else [fmt(b) + ("" if b.valid == 1 else "$^\\dagger$"), CLS[h2.classification] + ("" if h2.baseline_valid == 1 else "$^\\ddagger$")]
        rows.append(f"{esc(nice(d))} & " + " & ".join(cells_) + " \\\\")
    heads = ["PPI++ unclipped", "Selected", "class", "Selected", "class", "Selected", "base", "class", "asympt.", "meas."] + (["Selected", "class"] if useB5 else [])
    cs = "l" + "r" * 2 + "l" + "rl" + "rll" + "rr" + ("rl" if useB5 else "")
    k = len(heads)
    return ["\\begin{tabular}{" + cs + "}", "\\toprule",
            "& \\multicolumn{3}{c}{Ratio to package PPI++ [95\\% CI]} & \\multicolumn{2}{c}{to unclipped PPI++} & \\multicolumn{3}{c}{to strongest valid baseline} & \\multicolumn{2}{c}{Floor / PPI++}" + (" & \\multicolumn{2}{c}{Ratio, with $X$}" if useB5 else "") + " \\\\",
            "\\cmidrule(lr){2-4}\\cmidrule(lr){5-6}\\cmidrule(lr){7-9}\\cmidrule(lr){10-11}" + ("\\cmidrule(lr){12-13}" if useB5 else ""),
            "Dataset & " + " & ".join(heads) + " \\\\", "\\midrule", *rows, "\\bottomrule", "\\end{tabular}"]


