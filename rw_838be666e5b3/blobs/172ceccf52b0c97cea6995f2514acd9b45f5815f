                      + ", ".join(nice(r.dataset) for r in h2[h2.baseline_valid != 1].itertuples()) + "); against the strongest valid baseline their ratios are "
                      + ", ".join(f"{nice(r.dataset)} {r.ratio_vs_valid_baseline:.3f}" for r in h2.itertuples()) + ", all classed " + "/".join(sorted(set(h2.classification_vs_valid_baseline))) + ".")
    used = pd.concat([t[(t.method == a[1]) & (t.tier == a[2])] for a in arms + [("", "ppipp_unclip", "T1")]])
    captions.write("tables", "tab_main", "C2/C4: width and coverage of every arm per dataset, and the headline arm's paired width ratio to both PPI++ baselines with its pre-fixed class and the floor in two units.",
        "one row per dataset at its headline n; first block: cell = mean width in each dataset's own units (empirical coverage %), dagger = misses the win rule; second block: paired width ratio with 95% CI of PPI++ with the unclipped tuning (the calibrated spline arm is in tab_headline_full), and of the selected interval to the package PPI++ (`ppi-python` 0.2.3, clips the estimated tuning to [0, 1]), to the unclipped PPI++ and to the strongest valid baseline of the two, each with its class under the margin fixed before the runs (none = CI inside [0.98, 1.02]; gain = CI upper bound below 0.95 and valid; small = otherwise; classes from headline.csv, checked against the ratio in cells.csv); floor/PPI++ = estimated within-class floor as the ratio of the standard deviations (asympt.) and in measured-width units (meas.), neither a bound. Two stacked blocks in one table*, centred; use with \\footnotesize." + best_note + (f" Column(s) not shown because the reference-n results are missing for at least one dataset they apply to: {', '.join(dropped)}." if dropped else ""),
        "ratio below 1 with CI below 1 = shorter than PPI++; coverage is read next to width so a short interval that under-covers is visible.", used)


