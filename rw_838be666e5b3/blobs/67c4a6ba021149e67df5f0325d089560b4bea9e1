# ------------------------------------------------------------------------------------------- headline (C2)
REFERENCE_N = {"forest": 200}     # reference n per set, fixed before the runs (experiments/exp3_real.py): 500, except forest (N = 1000): 200
REFERENCE_N_DEFAULT = 500
BEST_OF = ["ppi", "strat_ppi", "calib_spline", "calib_iso", "select", "selectmin"]


def classify(lo, hi, valid):
    """Pre-fixed margin of the Outline: no gain if the ratio CI lies in [0.98, 1.02]; gain if its upper end is
    below 0.95 and the arm is valid; otherwise small / undecided."""
    if not (np.isfinite(lo) and np.isfinite(hi)):
        return "NA"
    if lo >= 0.98 and hi <= 1.02:
        return "no gain"
    if hi < 0.95 and valid == 1:
        return "gain"
    return "small / undecided"


def classification_of(h):
    return classify(h.ratio_lo, h.ratio_hi, h.valid)


def build_headline():
    """Headline arms per (dataset, n): T1 `select` (A6) and, where X exists, T2 `select_x` (B5), with the pre-fixed
    classification, the estimated-floor ratio and the best valid arm as a descriptive ceiling (biased towards gain).
    Reference-grid cells, Wald-z construction; `is_reference_n` marks the reference n of the set."""
    c = pd.read_csv(os.path.join(R_DIR, "cells.csv"))
    c = c[(c.group == "reference_grid") & (c.construction.isin(["wald"]) | c.construction.isna())]
    fs_path = os.path.join(R_DIR, "floors_strong.json")
    strong = json.load(open(fs_path)) if os.path.exists(fs_path) else {}
    rows = []
    for (ds, n, N), g in c.groupby(["dataset", "n", "N"]):
        def get(m):
            x = g[g.method == m]
            return x.iloc[0] if len(x) else None
        for tier, m, fl in (("T1", "select", "floor"), ("T2", "select_x", "floor_x")):
            h, f = get(m), get(fl)
            if h is None:
                continue
            ok = g[g.method.isin(BEST_OF) & (g.valid == 1)]
            best = ok.loc[ok.ratio_vs_ppipp.idxmin()] if (tier == "T1" and len(ok)) else None
            r = h.ratio_vs_ppipp
            # floors in *measured* units: z * sqrt(V*) over the measured PPI++ width of this cell (the predicted
            # `floor_ratio` divides by PPI++'s asymptotic variance, which excludes its in-sample learning cost);
            # `_strong`: V* from the best of a wider set of cross-fitted classes (results/floors_strong.json)
            fm = fstrong = fstrong_m = np.nan
            pp = get("ppipp")
            fk = floor_key(ds)
            if tier == "T1" and fk is not None and fk in FLOORS and pp is not None:
                M = n + N
                t1 = FLOORS[fk]["T1"]
                fm = 2 * Z * np.sqrt(t1["sigma2_res"] / n + t1["V_g"] / M) / pp.width_mean
                if ds in strong:
                    st_ = strong[ds]
                    vs = st_["sigma2_res"] / n + st_["V_g"] / M
                    fstrong_m = 2 * Z * np.sqrt(vs) / pp.width_mean
                    fstrong = np.sqrt(vs / predicted_variances(FLOORS[fk], n, N)["ppi++"])
            uc = get("ppipp_unclip")                  # T1 rows of the same cell: the unclipped PPI++ is paired with T2 arms through the shared draws
            # strongest *valid* PPI++ baseline (Outline rev. 9, fixed after the rev. 8 results were seen): the narrower of the package
            # and the unclipped PPI++ among those whose coverage is valid in this cell (Wilson upper limit >= 0.95, as for every arm);
            # if neither is, the narrower of the two is used and `baseline_valid` = 0
            cand = {}
            if pp is not None:
                cand["package"] = (r, h.ratio_lo, h.ratio_hi, bool(pp.cov_hi >= NOMINAL))
            if uc is not None and np.isfinite(h.ratio_vs_unclip):
                cand["unclipped"] = (h.ratio_vs_unclip, h.ratio_unclip_lo, h.ratio_unclip_hi, bool(uc.cov_hi >= NOMINAL))
            vb = {}
            if cand:
                pool_ = {k: v for k, v in cand.items() if v[3]} or cand
                k = max(pool_, key=lambda k: pool_[k][0])         # the narrower baseline is the one the arm's width ratio is largest against
                vb = dict(baseline_used=k, baseline_valid=int(cand[k][3]), ratio_vs_valid_baseline=cand[k][0],
                          ratio_valid_lo=cand[k][1], ratio_valid_hi=cand[k][2],
                          classification_vs_valid_baseline=classify(cand[k][1], cand[k][2], h.valid),
                          baseline_package_valid=int(cand["package"][3]) if "package" in cand else np.nan,
                          baseline_unclipped_valid=int(cand["unclipped"][3]) if "unclipped" in cand else np.nan)
            rows.append(dict(
                dataset=ds, n=n, N=N, tier=tier, headline_arm=m, is_reference_n=int(n == REFERENCE_N.get(ds, REFERENCE_N_DEFAULT)),
                ratio=r, ratio_lo=h.ratio_lo, ratio_hi=h.ratio_hi, label_saving=1 - r ** 2,
                coverage=h.coverage, cov_lo=h.cov_lo, valid=h.valid, valid_vs_ppipp=h.valid_vs_ppipp,
                classification=classify(h.ratio_lo, h.ratio_hi, h.valid),
                floor_ratio=f.ratio_vs_ppipp if f is not None else np.nan, floor_ratio_measured=fm,
                floor_ratio_strong=fstrong, floor_ratio_strong_measured=fstrong_m,
                unclip_ratio_vs_ppipp=uc.ratio_vs_ppipp if uc is not None else np.nan,
                unclip_coverage=uc.coverage if uc is not None else np.nan,
                ratio_vs_unclip=h.ratio_vs_unclip, ratio_unclip_lo=h.ratio_unclip_lo, ratio_unclip_hi=h.ratio_unclip_hi,
                classification_vs_unclip=classify(h.ratio_unclip_lo, h.ratio_unclip_hi, h.valid) if np.isfinite(h.ratio_vs_unclip) else "",
                ratio_vs_best_ppipp=max(r, h.ratio_vs_unclip) if np.isfinite(h.ratio_vs_unclip) else r,
                classification_vs_best=classify(max(h.ratio_lo, h.ratio_unclip_lo), max(h.ratio_hi, h.ratio_unclip_hi), h.valid)
                if np.isfinite(h.ratio_vs_unclip) else classification_of(h),
                best_valid_arm=best.method if best is not None else "", best_valid_ratio=best.ratio_vs_ppipp if best is not None else np.nan,
                **vb))
    df = pd.DataFrame(rows).sort_values(["tier", "dataset", "n"])
    df.to_csv(os.path.join(R_DIR, "headline.csv"), index=False)
    return df


def build_decomp():
    """results/decomp.csv from results/gene_decomp/*.npz (experiments/gene_decomp.py): arms that differ in one
    ingredient each, on the same draws. width = 2 z SE (Wald); ratio_vs_ppipp = mean width / PPI++ mean width (paired
    bootstrap over replicates); sd_est = empirical SD of the point estimate; population truth = pool mean."""
    rows = []
    rng = np.random.default_rng(1)
    for path in sorted(glob.glob(os.path.join(R_DIR, "gene_decomp", "*.npz"))):
        z = np.load(path)
        ds, sh = os.path.basename(path)[:-4].rsplit("_shift", 1)
        t = float(z["_truth"])
        ns = sorted({int(k.split("|")[0][1:]) for k in z.files if k.startswith("n")})
        for n in ns:
            arms = sorted({k.split("|")[1] for k in z.files if k.startswith(f"n{n}|")})
            ref_se = z[f"n{n}|ppi++|se"]
            R = len(ref_se)
            idx = rng.integers(0, R, size=(500, R))
            for a in arms:
                e, se = z[f"n{n}|{a}|est"], z[f"n{n}|{a}|se"]
                cov = np.abs(e - t) <= Z * se
                cl, ch = wilson(int(cov.sum()), R)
                rb = se[idx].mean(1) / ref_se[idx].mean(1)
                rows.append(dict(dataset=ds, shift_sd=float(sh), n=n, N=10000, reps=R, arm=a, coverage=cov.mean(), cov_lo=cl,
                                 cov_hi=ch, mean_se=se.mean(), sd_est=e.std(ddof=1), se_over_sd=se.mean() / e.std(ddof=1),
                                 bias=e.mean() - t, rmse=float(np.sqrt(((e - t) ** 2).mean())),
                                 ratio_vs_ppipp=se.mean() / ref_se.mean(), ratio_lo=np.quantile(rb, 0.025), ratio_hi=np.quantile(rb, 0.975),
                                 sd_ratio_vs_ppipp=e.std(ddof=1) / z[f"n{n}|ppi++|est"].std(ddof=1)))
    df = pd.DataFrame(rows)
    df.to_csv(os.path.join(R_DIR, "decomp.csv"), index=False)
    return df


# ------------------------------------------------------------------------------------------- E9: the lambda clip
def v_ppi(lam, n, N, var_y, var_f, cov_yf):
    """Exact variance of PPI++ (mean) with a fixed tuning lambda: Var(Y - lam f)/n + lam^2 Var(f)/N (independent sums)."""
    return (var_y - 2 * lam * cov_yf + lam ** 2 * var_f) / n + lam ** 2 * var_f / N


def clip_terms(n, N, var_y, var_f, cov_yf):
    """Population quantities of the clip: b = Cov(Y,f)/Var f, the optimal tuning lam* = b N/(n+N), the tuning the package
    can reach clip(lam*, 0, 1), their exact variances, and the excess (1/n - 1/M)(b - c)^2 Var f with c = lam M/N."""
    M = n + N
    b = cov_yf / var_f
    lam_s = b * N / M
    lam_c = float(np.clip(lam_s, 0.0, 1.0))
    v_u, v_c = v_ppi(lam_s, n, N, var_y, var_f, cov_yf), v_ppi(lam_c, n, N, var_y, var_f, cov_yf)
    c = lam_c * M / N
    return dict(b=b, lam_star=lam_s, lam_clipped=lam_c, v_unclip=v_u, v_pkg=v_c, excess=v_c - v_u,
                excess_closed_form=(1 / n - 1 / M) * (b - c) ** 2 * var_f, pred_width_ratio_unclip_over_pkg=np.sqrt(v_u / v_c))


def clip_pair(e_u, s_u, e_p, s_p, truth, idx):
    """Paired summary of the unclipped (u) vs package (p) PPI++ on the same draws."""
    R = len(s_u)
    out = {}
    for tag, e, s in (("pkg", e_p, s_p), ("unclip", e_u, s_u)):
        k = int((np.abs(e - truth) <= Z * s).sum())
        cl, ch = wilson(k, R)
        out.update({f"coverage_{tag}": k / R, f"cov_lo_{tag}": cl, f"cov_hi_{tag}": ch, f"mean_width_{tag}": 2 * Z * s.mean(),
                    f"sd_est_{tag}": e.std(ddof=1), f"se_over_sd_{tag}": s.mean() / e.std(ddof=1)})
    rb = s_u[idx].mean(1) / s_p[idx].mean(1)
    r = s_u.mean() / s_p.mean()
    out.update(width_ratio_unclip_over_pkg=r, ratio_lo=r - 1.96 * rb.std(ddof=1), ratio_hi=r + 1.96 * rb.std(ddof=1),
               sd_ratio_unclip_over_pkg=e_u.std(ddof=1) / e_p.std(ddof=1), label_saving_unclip_vs_pkg=1 - r ** 2)
    return out


def build_clip():
    """E9. clip_sweep.csv: synthetic populations f ~ N(0,1), Y = b f + sigma eps (known truth 0), package vs unclipped PPI++ on the same
    draws (and with lambda fixed at its optimum: no estimation of lambda), against the exact variance formula.
    clip_real.csv: the same quantities on the real pools (reference grid and the N/n cells, those with unclipped replicates)."""
    from pci.pops import load_pool
    rng = np.random.default_rng(2)
    rows = []
    for path in sorted(glob.glob(os.path.join(R_DIR, "exp9", "*.npz"))):
        z = np.load(path)
        m = json.loads(str(z["_meta"]))
        n, N, b, sg, R = m["n"], m["N"], m["b"], m["sigma"], m["R"]
        idx = rng.integers(0, R, size=(300, R))
        t = clip_terms(n, N, b * b + sg * sg, 1.0, b)
        row = dict(sigma=sg, n=n, N=N, M=n + N, reps=R, **t,
                   frac_lamhat_gt1=float((z["lam_hat_unclipped"] > 1).mean()), frac_lamhat_lt0=float((z["lam_hat_unclipped"] < 0).mean()),
                   lamhat_mean=float(z["lam_hat_unclipped"].mean()), lamhat_sd=float(z["lam_hat_unclipped"].std(ddof=1)))
        row.update(clip_pair(z["unclip|est"], z["unclip|se"], z["pkg|est"], z["pkg|se"], 0.0, idx))
        # estimation of lambda removed: fixed lambda at its optimum (unclipped) vs at clip(optimum)
        o = clip_pair(z["unclip_oracle|est"], z["unclip_oracle|se"], z["pkg_oracle|est"], z["pkg_oracle|se"], 0.0, idx)
        row.update({k + "_oracle": v for k, v in o.items()})
        row["sd_formula_unclip_oracle"] = float(np.sqrt(t["v_unclip"]))
        row["sd_formula_pkg_oracle"] = float(np.sqrt(t["v_pkg"]))
        row["sd_ratio_formula"] = float(np.sqrt(t["v_unclip"] / t["v_pkg"]))
        row["excess_var_measured_oracle"] = float(z["pkg_oracle|est"].var(ddof=1) - z["unclip_oracle|est"].var(ddof=1))
        row["label_saving_formula"] = 1 - t["v_unclip"] / t["v_pkg"]
        rows.append(row)
    sweep = pd.DataFrame(rows).sort_values(["sigma", "n", "N", "b"])
    sweep.to_csv(os.path.join(R_DIR, "clip_sweep.csv"), index=False)

    rows = []
    pools = {}
    for d in ("exp3", "exp4"):
        for path in sorted(glob.glob(os.path.join(R_DIR, "unclip", d, "*.npz"))):
            zu = np.load(path)
            m = json.loads(str(zu["_meta"]))
            cid = m["id"]
            zp = np.load(os.path.join(R_DIR, d, cid + ".npz"), allow_pickle=True)
            ds = dataset_name(m["pop"])
            if ds not in pools:
                pl = load_pool(ds)
                pools[ds] = (pl.truth, float(pl.Y.var()), float(pl.f.var()), float(np.cov(pl.Y, pl.f, bias=True)[0, 1]))
            truth, vy, vf, cyf = pools[ds]
            n, N, R = m["n"], m["N"], m["R"]
            idx = rng.integers(0, R, size=(300, R))
            t = clip_terms(n, N, vy, vf, cyf)
            lam_u = zu["lam_unclipped"]
            row = dict(dataset=ds, exp=d, n=n, N=N, M=n + N, reps=R, **t,
                       frac_lamhat_gt1=float((lam_u > 1).mean()), frac_lamhat_lt0=float((lam_u < 0).mean()),
                       lamhat_mean=float(lam_u.mean()), lamhat_sd=float(lam_u.std(ddof=1)))
            row.update(clip_pair(zu["est"], zu["se"], zp["ppi++|est"], zp["ppi++|se"], truth, idx))
            row["sd_ratio_formula"] = float(np.sqrt(t["v_unclip"] / t["v_pkg"]))
            rows.append(row)
    real = pd.DataFrame(rows).sort_values(["exp", "dataset", "n", "N"])
    real.to_csv(os.path.join(R_DIR, "clip_real.csv"), index=False)
    return sweep, real


