def build_ladder():
    c = pd.read_csv(os.path.join(R_DIR, "cells.csv"))
    c = c[c.group.isin(["reference_grid", "stress_monotone_transform", "side_information", "disjoint_check"])]
    steps = [("classical", ["labels_z"]), ("ppi", ["ppi"]), ("ppipp", ["ppipp"]), ("clip", ["ppipp_unclip"]), ("calib_T1", ["select"]),
             ("calib_T2", ["select_x"]), ("floor", ["floor"]), ("floor_T2", ["floor_x"])]
    rows = []
    for (ds, n, N, grp), g in c.groupby(["dataset", "n", "N", "group"]):
        for step, ms in steps:
            m = ms[0]
            w = g[(g.method == m) & (g.construction.isin(["wald", "NA"]))]
            if w.empty:
                continue
            w = w.iloc[0]
            alt = g[(g.method == m) & (g.construction.isin(["wilson"] if is_binary(ds) else ["t"]))]
            wald_w = w.width_mean
            constr = alt.iloc[0].width_mean / wald_w if (len(alt) and np.isfinite(wald_w) and wald_w > 0) else np.nan
            rows.append(dict(dataset=ds, n=n, N=N, group=grp, step=step, method=m, tier=w.tier,
                             width_mean=wald_w, ratio_vs_ppipp=w.ratio_vs_ppipp, ratio_lo=w.ratio_lo, ratio_hi=w.ratio_hi,
                             se_ratio=w.ratio_vs_ppipp, constr_ratio=constr,
                             total_ratio=w.ratio_vs_ppipp * constr if np.isfinite(constr) else np.nan,
                             coverage=w.coverage, cov_lo=w.cov_lo, cov_hi=w.cov_hi, valid=w.valid,
                             alt_construction="wilson" if is_binary(ds) else "t"))
    df = pd.DataFrame(rows)
    df.to_csv(os.path.join(R_DIR, "ladder.csv"), index=False)
    return df


# ------------------------------------------------------------------------------------------- SE variants
def build_variants():
    """Fold-pooled residual variance (default `se`) vs per-fold-centred residual variance (`se_pf`) for the
    cross-fitted pooled estimators; Wald-z intervals, same estimates."""
    rows = []
    for d, p in cell_paths():
        if d not in ("exp1", "exp3", "exp3b"):
            continue
        arms, meta = load_cell(p)
        n, N, R, truth = meta["n"], meta["N"], meta["R"], meta["truth"]
        for a, mid in (("pool_linear", "pooled_linear"), ("pool_spline", "calib_spline"), ("pool_isotonic", "calib_iso")):
            if a not in arms:
                continue
            w0 = None
            for var, key in (("fold_pooled", "se"), ("per_fold", "se_pf")):
                e, se = arms[a]["est"], arms[a][key]
                lo, hi = e - Z * se, e + Z * se
                cov = (lo <= truth) & (truth <= hi)
                k = int(cov.sum())
                cl, ch = wilson(k, R)
                w = (hi - lo)
                ok = np.isfinite(w) & (w > 0)
                if w0 is None:
                    w0 = w
                rows.append(dict(dataset=dataset_name(meta["pop"]), group=group_of(meta["id"], meta["pop"], d), n=n, N=N,
                                 method=mid, variant=var, reps=R, coverage=k / R, cov_lo=cl, cov_hi=ch,
                                 width_mean=float(w[ok].mean()), ratio_vs_default=float(w[ok].mean() / w0[ok].mean())))
    df = pd.DataFrame(rows)
    df.to_csv(os.path.join(R_DIR, "se_variants.csv"), index=False)
    return df


