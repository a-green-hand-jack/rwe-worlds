"""Build refs.bib for the arXiv-listed sources from the arXiv API metadata (title, authors, year, id)."""
import re, sys, time, urllib.request, xml.etree.ElementTree as ET
ids = sys.argv[2:]
ns = {'a': 'http://www.w3.org/2005/Atom'}
out = []
for i in ids:
    key, aid = i.split('=')
    url = f'https://export.arxiv.org/api/query?id_list={aid}'
    root = ET.fromstring(urllib.request.urlopen(url, timeout=60).read())
    e = root.find('a:entry', ns)
    title = re.sub(r'\s+', ' ', e.find('a:title', ns).text.strip())
    authors = ' and '.join(a.find('a:name', ns).text for a in e.findall('a:author', ns))
    year = e.find('a:published', ns).text[:4]
    out.append(f'@misc{{{key},\n  title={{{title}}},\n  author={{{authors}}},\n  year={{{year}}},\n  eprint={{{aid}}},\n  archivePrefix={{arXiv}}\n}}\n')
    time.sleep(3)
open(sys.argv[1], 'w').write('\n'.join(out))
