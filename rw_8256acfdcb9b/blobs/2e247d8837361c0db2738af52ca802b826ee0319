"""M5 probit decision fit. usage: probit_fit.py [OUT_DIR]  -> probit_points.parquet, probit_fit.csv, probit_collapse.csv"""
import sys, os, glob, re
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))
import numpy as np, pandas as pd
from multiprocessing import Pool
from shapreliab import probit as PR, pipeline as P

out = sys.argv[1] if len(sys.argv) > 1 else "results/tables"


def one(a):
    ds, kind = a
    rows = []
    for f in sorted(glob.glob(os.path.join(P.cell_dir(ds, 0), f"inst_{kind}_*.npz"))):
        if f.endswith(".tmp.npz"):
            continue
        rows += PR.instance_points(ds, kind, int(re.search(r"_(\d+)\.npz$", f).group(1)))
    return rows


if __name__ == "__main__":
    with Pool(4) as p:
        res = p.map(one, [(ds, k) for ds in P.N_INST for k in P.KINDS if k != "lr"], chunksize=1)
    pts = PR.add_sigma_loo(pd.DataFrame([r for rr in res for r in rr]))
    pts.to_parquet(os.path.join(out, "probit_points.parquet"), index=False)
    fits, cols = [], []
    for cell, g in pts.groupby(["dataset", "model", "estimator", "l1_reg"], sort=False):
        for sc in ("sigma_loo", "sigma_plugin"):
            for lab, lo in (("all budgets", 0), ("m_eff>=256", 256), ("m_eff>=1024", 1024)):
                r = PR.fit_cell(g[g.m_eff >= lo], sc)
                if r:
                    r[0]["budget_range"] = lab
                    for c in r[1]:
                        c["budget_range"] = lab
                    r[0]["d"] = int(g.d.iloc[0])
                    fits.append(r[0]); cols += r[1]
                    print(cell, sc, lab, round(r[0]["beta"], 3), round(r[0]["beta_ci_lo"], 3), round(r[0]["beta_ci_hi"], 3), flush=True)
    pd.DataFrame(fits).to_csv(os.path.join(out, "probit_fit.csv"), index=False)
    pd.DataFrame(cols).to_csv(os.path.join(out, "probit_collapse.csv"), index=False)
