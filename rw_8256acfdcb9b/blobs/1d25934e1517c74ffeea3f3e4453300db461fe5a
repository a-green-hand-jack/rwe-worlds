"""Arrhythmia (d=279) large-d extension: per-instance and summary tables from results of large_d_arrhythmia.py.

Reference: interventional TreeSHAP on the same B=50 background. Per (model, estimator variant, budget): P_c strict and
tolerance-aware (eps=0.05, as in the main grid), share of instances with P_c >= 0.9, run-to-run agreement (floor a),
mean Pearson with the reference, by margin quartile (within model, k=3 margin of the reference), instance bootstrap CIs.
"""
import sys, os, glob, re
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))
import numpy as np, pandas as pd
from shapreliab import metrics as M, pipeline as P
from shapreliab.analyze import agreement

DS, SEED, KS, EPS = "arrhythmia", 0, (1, 3, 5), 0.05
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "results", "tables")
rng = np.random.default_rng(20260101)
NAMES = {"noreg": "shap Kernel, l1_reg=False", "auto": "shap Kernel, l1_reg=auto",
         "nf10": "shap Kernel, default l1_reg=num_features(10)"}


def rows():
    out, meta = [], []
    for fn in sorted(glob.glob(os.path.join(P.cell_dir(DS, SEED), "inst_*.npz"))):
        kind, i = re.match(r".*inst_(\w+)_(\d+)\.npz", fn).groups()
        r = np.load(fn)
        ref = r["phi_tree"]
        meta.append(dict(model=kind, instance_id=int(i), fx=float(r["fx"]), base=float(r["base"]),
                         additivity_gap=float(ref.sum() - (r["fx"] - r["base"])), phi_abs_max=float(np.abs(ref).max())))
        for key in r.files:
            mt = re.match(r"^shap_(noreg|auto|nf10)_(\d+)$", key)
            if not mt:
                continue
            est, name, m = r[key], mt.group(1), int(mt.group(2))
            R = len(est)
            pear = np.mean([np.corrcoef(e, ref)[0, 1] for e in est])
            for k in KS:
                ok = M.correct_exact(est, ref, k)
                okt, n_extra = M.correct_tol(est, ref, k, EPS)
                out.append(dict(model=kind, instance_id=int(i), estimator=name, m=m, k=k, R=R,
                                pc=ok.mean(), pc_tol=okt.mean(), n_extra=n_extra, margin=M.margin(ref, k),
                                agreement=agreement(est, k), pearson=pear))
    return pd.DataFrame(out), pd.DataFrame(meta)


def bci(v, nb=2000):
    v = np.asarray(v, float)
    b = v[rng.integers(0, len(v), (nb, len(v)))].mean(1)
    return np.percentile(b, [2.5, 97.5])


def summarize(il):
    il = il.copy()
    il["quartile"] = il.groupby(["model", "estimator", "m", "k"])["margin"].transform(
        lambda s: pd.qcut(s.rank(method="first"), 4, labels=["Q1", "Q2", "Q3", "Q4"]).astype(str))
    res = []
    for (mo, est, m, k), g in il.groupby(["model", "estimator", "m", "k"]):
        for q, h in [("all", g)] + [(q, h) for q, h in g.groupby("quartile")]:
            row = dict(dataset=DS, model=mo, estimator=est, m=m, k=k, quartile=q, n_instances=len(h), R=int(h.R.iloc[0]))
            for col, tag in (("pc", "pc"), ("pc_tol", "pc_tol"), ("agreement", "agreement"), ("pearson", "pearson")):
                row[tag] = h[col].mean()
                lo, hi = bci(h[col])
                row[tag + "_lo"], row[tag + "_hi"] = lo, hi
            row["share_pc_ge_0.9"] = (h.pc >= 0.9).mean()
            row["share_pc_tol_ge_0.9"] = (h.pc_tol >= 0.9).mean()
            row["margin_median"] = h.margin.median()
            row["n_extra_median"] = h.n_extra.median()
            res.append(row)
    return pd.DataFrame(res)


if __name__ == "__main__":
    il, meta = rows()
    il.to_csv(os.path.join(OUT, "large_d_arrhythmia_instances.csv"), index=False)
    meta.to_csv(os.path.join(OUT, "large_d_arrhythmia_reference.csv"), index=False)
    s = summarize(il)
    s.to_csv(os.path.join(OUT, "large_d_arrhythmia.csv"), index=False)
    pd.set_option("display.width", 250, "display.max_columns", 30)
    print(s[(s.quartile == "all") & (s.k == 3)][["model", "estimator", "m", "n_instances", "R", "pc", "pc_lo", "pc_hi", "pc_tol", "share_pc_ge_0.9", "agreement", "pearson", "margin_median"]].round(3).to_string())
    print(meta.groupby("model")[["additivity_gap", "phi_abs_max"]].describe().T.round(5))
