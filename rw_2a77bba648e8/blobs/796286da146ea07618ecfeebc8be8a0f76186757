#!/bin/sh
# Fetch the sample of accepted NeurIPS papers (proceedings PDFs) into the directory $1.
set -e
d=${1:?dir}; mkdir -p "$d"
f() { curl -sfL -m 120 -o "$d/$1.pdf" "https://proceedings.neurips.cc/paper_files/paper/$2/file/$3-Paper-Conference.pdf"; }
