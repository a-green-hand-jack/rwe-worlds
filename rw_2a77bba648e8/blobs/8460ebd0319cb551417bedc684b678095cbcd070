"""Fig 6 (C5): graph-cluster randomization. RMSE of three arms on the same graph and mechanism:
Chin regression under the cluster design (filled blue), difference in means under the cluster design (black square),
Chin regression under the Bernoulli design (open blue). Rows are cluster designs (graph, partition) ordered by the realised
modularity Q of the partition; one panel per mechanism (a linear, c saturating, d threshold); s=1/2, sigma=0.5, p=1/2.
Louvain at gamma=1,3 recovers the planted partition on the core SBM (same Q), which is shown once as "planted".
gamma=0.3 gives one cluster on every synthetic graph (no design exists, see cluster_quality.csv); it is shown for the real graphs only.
Usage: fig6_cluster.py RESULTS_DIR OUT_DIR
"""
import argparse

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

import common
import style

ap = argparse.ArgumentParser()
ap.add_argument("data"); ap.add_argument("out")
ap.add_argument("--sigma", type=float, default=0.5); ap.add_argument("--s", type=float, default=0.5)
a = ap.parse_args()
style.apply()
cells, meta = common.load(a.data, "cells")
cells = cells[np.isclose(cells.sigma, a.sigma) & np.isclose(cells.s, a.s) & cells.estimator.isin(["Chin", "DM"])]
MECH = ["a", "c", "d"]
TITLE = {"a": "(a) linear", "c": "(c) saturating", "d": "(d) threshold"}
# (label, cluster run, Bernoulli run on the same graph)
D = {5: "core_SBM_n3000_d5_p0.5", 20: "core_SBM_n3000_d20_p0.5", 80: "core_SBM_n3000_d80_p0.5"}
SPEC = [("SBM, planted, $d=5$", "clus_SBM_d5_truth_p0.5", D[5]), ("SBM, planted, $d=20$", "clus_SBM_d20_truth_p0.5", D[20]),
        ("SBM, planted, $d=80$", "clus_SBM_d80_truth_p0.5", D[80]),
        ("ego-FB, $\\gamma=0.3$", "clus_ego-Facebook_d20_res0.3_p0.5", "real_ego-Facebook_d20_p0.5"),
        ("ego-FB, $\\gamma=1$", "clus_ego-Facebook_d20_res1.0_p0.5", "real_ego-Facebook_d20_p0.5"),
        ("ego-FB, $\\gamma=3$", "clus_ego-Facebook_d20_res3.0_p0.5", "real_ego-Facebook_d20_p0.5"),
        ("Stanford3, $\\gamma=1$", "clus_Stanford3_d20_res1.0_p0.5", "real_Stanford3_d20_p0.5"),
        ("Stanford3, $\\gamma=3$", "clus_Stanford3_d20_res3.0_p0.5", "real_Stanford3_d20_p0.5"),
        ("weak SBM, $\\gamma=1$", "clus_SBMweak_d20_res1.0_p0.5", None), ("weak SBM, $\\gamma=3$", "clus_SBMweak_d20_res3.0_p0.5", None),
        ("BA, $\\gamma=1$", "clus_BA_d20_res1.0_p0.5", "fam_BA_n3000_d20_p0.5"), ("BA, $\\gamma=3$", "clus_BA_d20_res3.0_p0.5", "fam_BA_n3000_d20_p0.5"),
        ("ER, $\\gamma=1$", "clus_ER_d20_res1.0_p0.5", "fam_ER_n3000_d20_p0.5"), ("ER, $\\gamma=3$", "clus_ER_d20_res3.0_p0.5", "fam_ER_n3000_d20_p0.5"),
        ("Stanford3, $\\gamma=0.3$", "clus_Stanford3_d20_res0.3_p0.5", "real_Stanford3_d20_p0.5")]
Q = cells.drop_duplicates("run_id").set_index("run_id").cluster_modularity
SPEC = sorted(SPEC, key=lambda r: (-round(Q[r[1]], 2), SPEC.index(r)))   # by modularity, ties in the order listed
rows = []
for lab, rc, rb in SPEC:
    for m in MECH:
        for arm, rid, est in [("cluster, Chin", rc, "Chin"), ("cluster, DM", rc, "DM"), ("Bernoulli, Chin", rb, "Chin")]:
            if rid is None:
                continue
            r = cells[(cells.run_id == rid) & (cells.mechanism == m) & (cells.estimator == est)]
            assert len(r) == 1, (rid, m, est)
            r = r.iloc[0]
            rows.append(dict(row=lab, run_id=rid, modularity=Q[rc], mechanism=m, arm=arm, rmse=r.rmse, lo=r.rmse_mc_lo, hi=r.rmse_mc_hi,
                             n_clusters=r.n_clusters, n_draws=r.n_draws))
df = pd.DataFrame(rows)
# the weak SBM has no Bernoulli run with the same mixing: its arm is omitted (it is a cluster-design-only run)
ARM = {"cluster, Chin": dict(color="#0072B2", marker="o", mfc="#0072B2", dy=-0.22),
       "cluster, DM": dict(color="k", marker="s", mfc="k", dy=0.0),
       "Bernoulli, Chin": dict(color="#0072B2", marker="D", mfc="white", dy=0.22)}
fig, axs = plt.subplots(1, 3, figsize=(style.TEXTWIDTH, 3.3), sharey=True, gridspec_kw=dict(wspace=0.2))
for ax, m in zip(axs, MECH):
    for i, (lab, rc, rb) in enumerate(SPEC):
        for arm, st in ARM.items():
            r = df[(df.row == lab) & (df.mechanism == m) & (df.arm == arm)]
            if not len(r):
                continue
            r = r.iloc[0]; y = i + st["dy"]
            ax.plot([r.lo, r.hi], [y, y], color=st["color"], lw=0.8, zorder=2)
            ax.plot(r.rmse, y, marker=st["marker"], ms=3.2, color=st["color"], mfc=st["mfc"], mew=0.8, ls="", zorder=3)
        ax.axhline(i + 0.5, color="0.9", lw=0.5, zorder=0)
    ax.set_xscale("log"); ax.set_xlim(0.025, 1.0); ax.set_xticks([0.03, 0.1, 0.3, 1]); ax.set_xticklabels(["0.03", "0.1", "0.3", "1"]); ax.minorticks_off()
    ax.set_title(TITLE[m], fontsize=style.MIN_PT, pad=3); ax.set_xlabel("RMSE (units of $\\tau$)")
    ax.grid(axis="y", visible=False)
axs[0].set_yticks(range(len(SPEC)))
axs[0].set_yticklabels([f"{lab}  {Q[rc]:.2f}" for lab, rc, rb in SPEC]); axs[0].invert_yaxis()
axs[0].set_ylabel("cluster design (graph, partition)  modularity $Q$")
from matplotlib.lines import Line2D
h = [Line2D([], [], color=st["color"], marker=st["marker"], mfc=st["mfc"], ms=3.2, ls="-", lw=0.8) for st in ARM.values()]
fig.legend(h, list(ARM), loc="lower center", ncol=3, frameon=False, bbox_to_anchor=(0.5, -0.06), columnspacing=1.2, handletextpad=0.4)
style.check_min_type(fig)
o = common.out_dir(meta, a.out)
style.save(fig, o / "fig6_cluster.pdf"); df.to_csv(o / "fig6_cluster.csv", index=False)
