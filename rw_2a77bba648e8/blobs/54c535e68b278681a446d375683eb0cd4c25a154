         "c4_breakeven": be, "c4_sstar_predicted": c4_sstar_predicted(c, be), "c4_rule_ci": c4_rule_ci(r, c), "c5_d20_reduction": c5_d20(c5_cluster(c)), "c4_regime_share": c4_regime_share(r, c), "c4_rule": c4_rule(r, c), "c5_cluster": c5_cluster(c),
