"""Statistics of a sample of accepted NeurIPS main-track papers on interference / network experiments.

Usage: python3 -I tools/accepted_stats.py PDF_DIR   (PDFs fetched by tools/fetch_sample.sh)
Heuristics (text extraction, so +-1 on counts):
  main text = pages up to and including the page with the 'References' heading, text before it;
  figures/tables = distinct 'Figure N' / 'Table N' captions at a line start in the main text;
  abstract words = text between 'Abstract' and '1 Introduction';
  references = lines at the left margin of the reference pages (hanging indent) or [n] labels.
"""
import re
import sys
from collections import Counter
from pathlib import Path

import pymupdf

# reference pages (first, last) read off each PDF; main text ends on the first
REFPAGES = {
    "markovian22": (11, 14), "staggered22": (11, 12), "bipartite22": (11, 12),
    "embeddings22": (11, 12), "covdesign23": (10, 13), "mabnet24": (9, 11),
    "hocmp24": (11, 14),
}


def main(d):
    for name, (a, b) in REFPAGES.items():
        doc = pymupdf.open(Path(d) / f"{name}.pdf")
        pages = [p.get_text() for p in doc]
        main_txt = "\n".join(pages[:a - 1]) + "\n" + re.split(r"^\s*References\s*$", pages[a - 1], flags=re.M)[0]
        figs = sorted({int(x) for x in re.findall(r"^\s*Figure (\d+)\s*[:.]", main_txt, re.M)})
        tabs = sorted({int(x) for x in re.findall(r"^\s*Table (\d+)\s*[:.]", main_txt, re.M)})
        m = re.search(r"Abstract\s*\n(.*?)\n\s*1\s*\n?\s*Introduction", main_txt, re.S) or \
            re.search(r"Abstract\s*\n(.*?)\n\s*1\.\s*Introduction", main_txt, re.S)
        ab = len(m.group(1).split()) if m else None
        lines, started = [], False
        for pi in range(a - 1, b):
            for bl in doc[pi].get_text("dict")["blocks"]:
                for l in bl.get("lines", []):
                    t = "".join(s["text"] for s in l["spans"]).strip()
                    if pi == a - 1 and not started:
                        started = t == "References"
                        continue
                    lines.append((round(l["bbox"][0]), t))
        c = Counter(x for x, _ in lines)
        x0 = min(k for k in c if c[k] > 5)
        reftxt = "\n".join(t for _, t in lines)
        reftxt = re.split(r"^\s*Checklist\s*$", reftxt, flags=re.M)[0]
        labels = re.findall(r"^\[([^\]]+)\]", reftxt, re.M)
        if labels:  # [n] or [Bor+16] labelled lists
            nref = len(set(labels))
        else:
            nref = sum(1 for x, t in lines if abs(x - x0) <= 1 and len(t) > 8 and not re.fullmatch(r"\d+", t))
        print(f"{name}: pdf_pages={len(doc)} references_start_page={a} figures={len(figs)} tables={len(tabs)} "
              f"abstract_words={ab} references={nref}")


main(sys.argv[1])
