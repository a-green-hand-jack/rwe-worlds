"""Graph neural network estimator of the global effect (Tier A baseline), on the Tier A cells.
Network: two rounds of mean aggregation over the observed graph.  Node input x_i = (z_i, mean_{j~i} z_j, standardised log degree);
  h1 = ReLU(W1 [x_i, mean_j x_j]),  h2 = ReLU(W2 [h1_i, mean_j h1_j]),  yhat_i = w.h2_i + b          (hidden width 16).
Training: full-batch Adam on squared error, lr 0.02, up to 150 epochs.  The weight decay in {1e-4, 1e-2, 1e-1} and the number of epochs (checkpoints every 25 up to 150)
are chosen as for the other Tier A learners, by a graph-cluster hold-out loss (Louvain clusters of the observed graph, two of five folds held out, nodes next to a held-out
fold removed from training) PLUS a corner loss (fit on the nodes below the 0.7-quantile of the treated-neighbour fraction f, score above it); the model is refitted on all
nodes with the chosen setting.  tau_hat = mean(yhat at z = 1 and f = 1 for every node) - mean(yhat at z = 0 and f = 0): the same corner as every other estimator.
The assignments, graphs, outcome noise and Louvain folds are those of `tierA.run_tierA` (same seeds, same random-number stream); `chin_check` carries the Chin regression
estimate as a check that the stream is reproduced."""
import time

import numpy as np
import torch
import scipy.sparse as sp

from . import graphs, mech, sim
from .mech import COLS, Exposure, corner, make_base
from .sim import NOISE_M, ols_w, phi, seed_of
from .tierA import TEST_COLS

WD = (1e-4, 1e-2, 1e-1)
CKPT = tuple(range(25, 151, 25))
HID = 16
torch.set_num_threads(1)


def _agg_matrix(A):
    A = A.tocsr().astype(np.float32)
    d = np.asarray(A.sum(1)).ravel()
    P = sp.diags(1.0 / np.maximum(d, 1.0)) @ A
    P = P.tocoo()
    return torch.sparse_coo_tensor(np.vstack([P.row, P.col]), P.data.astype(np.float32), P.shape).coalesce()


class Net(torch.nn.Module):
    def __init__(self, din):
        super().__init__()
        self.l1 = torch.nn.Linear(2 * din, HID)
        self.l2 = torch.nn.Linear(2 * HID, HID)
        self.out = torch.nn.Linear(HID, 1)

    def forward(self, x, P):
        h = torch.relu(self.l1(torch.cat([x, torch.sparse.mm(P, x)], 1)))
        h = torch.relu(self.l2(torch.cat([h, torch.sparse.mm(P, h)], 1)))
        return self.out(h).squeeze(1)


def _feat(z, P, logd):
    zt = torch.as_tensor(z, dtype=torch.float32)[:, None]
    return torch.cat([zt, torch.sparse.mm(P, zt), torch.as_tensor(logd, dtype=torch.float32)[:, None]], 1)


def _fit(x, y, P, train, wd, seed, score=None):
    """train a net on the nodes `train` (bool); returns the net, or the validation loss per checkpoint if `score` (bool mask) is given"""
    torch.manual_seed(seed)
    net = Net(x.shape[1])
    opt = torch.optim.Adam(net.parameters(), lr=0.02, weight_decay=wd)
    tr = torch.as_tensor(np.flatnonzero(train))
    sc = None if score is None else torch.as_tensor(np.flatnonzero(score))
    losses = []
    for ep in range(1, CKPT[-1] + 1):
        opt.zero_grad()
        loss = ((net(x, P)[tr] - y[tr]) ** 2).mean()
        loss.backward()
        opt.step()
        if sc is not None and ep in CKPT:
            with torch.no_grad():
                losses.append(float(((net(x, P)[sc] - y[sc]) ** 2).mean()))
    return losses if sc is not None else net


def gnn_tau(y, z, f, P, logd, x1, x0, fold_of, nbr_buffer, seed):
    n = len(y)
    x = _feat(z, P, logd)
    ym, ys = y.mean(), y.std() + 1e-12
    yt = torch.as_tensor((y - ym) / ys, dtype=torch.float32)
    held = np.isin(fold_of, (0, 1))
    near = (nbr_buffer[0] | nbr_buffer[1]) & ~held
    tr1 = ~held & ~near
    if tr1.sum() < 0.3 * n:
        tr1 = ~held
    thr = np.quantile(f, 0.7)
    tr2, te2 = f <= thr, f > thr
    loss = np.zeros((len(WD), len(CKPT)))
    for a, wd in enumerate(WD):
        loss[a] += np.array(_fit(x, yt, P, tr1, wd, seed, score=held))
        if te2.sum() >= 10 and tr2.sum() >= 30:
            loss[a] += np.array(_fit(x, yt, P, tr2, wd, seed, score=te2))
    a, k = np.unravel_index(np.argmin(loss), loss.shape)
    wd, ep = WD[a], CKPT[k]
    torch.manual_seed(seed)
    net = Net(x.shape[1])
    opt = torch.optim.Adam(net.parameters(), lr=0.02, weight_decay=wd)
    for _ in range(ep):
        opt.zero_grad()
        ((net(x, P) - yt) ** 2).mean().backward()
        opt.step()
    with torch.no_grad():
        t1, t0 = net(x1, P).mean().item(), net(x0, P).mean().item()
    return (t1 - t0) * ys, wd, ep


def run_gnn(cfg, cols=None, r_use=None):
    """cfg is a Tier A config (grid.tierA_runs); returns tau_hat_gnn (NR x J), chin_check (NR x J), selected wd and epochs.
    r_use: only the first r_use of the R assignments of each graph are used (the same assignments as the first r_use of tierA); `rows` gives their row in the Tier A arrays"""
    t0 = time.time()
    Gn, R, p = cfg["G"], cfg["R"], cfg["p"]
    r_use = R if r_use is None else min(r_use, R)
    NR = Gn * r_use
    rows = np.array([gi * R + r for gi in range(Gn) for r in range(r_use)])
    cols = TEST_COLS if cols is None else cols
    th = np.full((NR, len(COLS)), np.nan, np.float32)
    chk = np.full((NR, len(COLS)), np.nan, np.float32)
    sel = np.full((NR, 2, len(COLS)), np.nan, np.float32)
    taul = []
    for gi in range(Gn):
        rng = np.random.default_rng(seed_of(cfg.get("seed", 0), cfg["family"], cfg.get("n", 0), cfg["d"], gi, cfg.get("tag", ""), "graph"))
        g = sim.make_graph(cfg, gi, rng)
        n_ = g.n
        deg, dbar = g.deg, g.dbar
        logd = np.log(deg); logd = (logd - logd.mean()) / (logd.std() + 1e-12)
        lab, _ = graphs.louvain(g, 1.0, rng)
        K = lab.max() + 1
        fold_of = rng.integers(0, 5, K)[lab]
        Ab = g.A.tocsr()
        nbr_buffer = {k: (Ab @ (fold_of == k).astype(float)) > 0 for k in range(5)}
        base = make_base(g, cfg.get("base", "iid"), rng)
        tau = mech.exact_tau(g)
        E1, E0 = corner(g, 1), corner(g, 0)
        design = sim.Design("bern", p)
        prng = np.random.default_rng(seed_of(cfg.get("seed", 0), cfg["family"], cfg.get("n", 0), cfg["d"], gi, cfg.get("tag", ""), "pilot"))
        pil = []
        for _ in range(30):
            z = design.draw(prng, n_); Et = Exposure(g, z); Dt = mech.diffusion(g, z)
            pil.append(mech.outcomes(g, z, Et, Dt, base))
        sd = np.concatenate(pil).std(0)
        taul.append(tau)
        P = _agg_matrix(g.A)
        x1, x0 = _feat(np.ones(n_), P, logd), _feat(np.zeros(n_), P, logd)
        arng = np.random.default_rng(seed_of(cfg.get("seed", 0), cfg["family"], cfg.get("n", 0), cfg["d"], gi, cfg.get("tag", ""), "assign"))
        for r in range(r_use):
            row = gi * r_use + r
            z = design.draw(arng, n_)
            Et = Exposure(g, z); Dt = mech.diffusion(g, z)
            eps = arng.standard_normal(n_)
            Y0 = mech.outcomes(g, z, Et, Dt, base)
            Ym = Y0 + NOISE_M * sd[None, :] * eps[:, None]
            f = Et.f
            kn = sorted(set(np.round([k for k in np.quantile(f, [0.25, 0.5, 0.75]) if 1e-9 < k < 1 - 1e-9], 9)))
            X = phi("chin", Et, kn, dbar)
            dx = (phi("chin", E1, kn, dbar) - phi("chin", E0, kn, dbar)).mean(0)
            wch = ols_w(X, dx)[0]
            for j in cols:
                chk[row, j] = wch @ Ym[:, j]
                th[row, j], sel[row, 0, j], sel[row, 1, j] = gnn_tau(Ym[:, j], z, f, P, logd, x1, x0, fold_of, nbr_buffer, seed=row * 31 + j)
    return dict(rows=rows, tau_hat=th, chin_check=chk, sel=sel, tau=np.array(taul), cfg=cfg, seconds=time.time() - t0)
