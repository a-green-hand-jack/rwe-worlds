"""Shared figure style. Widths, height budget and minimum type size are the venue's (VENUE below); every text element is >= MIN_PT at the printed width."""
import matplotlib as mpl

VENUE = dict(name="NeurIPS 2026 main track (venue.md)", text_width_in=5.5, panel_width_in=2.7, max_height_in=2.3, min_pt=7.0)

# Okabe-Ito, colour-blind safe; roles fixed across figures
C = dict(reported="#D55E00", fresh="#0072B2", noise="#999999", bound="#009E73",
         accent="#CC79A7", ink="#222222", light="#E8E8E8")


def apply():
    # mathtext shrinks sub/superscripts to 70 % (a 7 pt label would carry 4.9 pt indices); keep them at the label size so no glyph prints below MIN_PT
    import matplotlib._mathtext as _mt
    _mt.SHRINK_FACTOR = 1.0
    mpl.rcParams.update({
        "font.family": "serif", "font.serif": ["DejaVu Serif"], "mathtext.fontset": "dejavuserif",
        "font.size": 8, "axes.labelsize": 8, "axes.titlesize": 8, "legend.fontsize": 7,
        "xtick.labelsize": 7, "ytick.labelsize": 7,
        "axes.spines.top": False, "axes.spines.right": False, "axes.linewidth": 0.6,
        "lines.linewidth": 1.3, "pdf.fonttype": 42, "ps.fonttype": 42,
        "savefig.bbox": "standard", "savefig.pad_inches": 0.0,
    })


import pandas as pd
RESULTS = "code/results"  # location in paper-repo; scripts take the directory as an argument


def load(results_dir, name):
    return pd.read_parquet(f"{results_dir}/{name}.parquet")


def errbar(ax, x, y, lo, hi, **kw):
    """point + interval; interval kind is stated in the caption (ci_kind column of the file)."""
    import numpy as np
    x, y, lo, hi = (np.atleast_1d(np.asarray(v, dtype=float)) for v in (x, y, lo, hi))
    ax.errorbar(x, y, yerr=[np.clip(y - lo, 0, None), np.clip(hi - y, 0, None)], capsize=1.5, elinewidth=0.8, **kw)


def panel_label(ax, s):
    ax.text(0.0, 1.04, s, transform=ax.transAxes, fontsize=8, weight="bold", va="bottom", ha="left")
