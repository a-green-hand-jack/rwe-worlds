ilings: `host`\n```", "exit": null}}}, {"id": "fdb81634-2a64-5fd8-851e-1d734d4d4cc0", "at": 1795716126.2507687, "clock": "host", "stream": "runner", "sequence": 56705, "layer": "worker", "category": "message", "kind": "session.session/request_permission", "role": "experiment-repo", "actor": "experiment-repo", "execution_id": "850fc1e5d1921cf13868244b1934a8e9", "trust": "agent-reported", "outcome": null, "label": "message", "repository": null, "flags": [], "causes": [], "summary": "session/request_permission"}, {"id": "d5fc84d3-cc66-555c-8adc-3af66daa262c", "at": 1795716126.2553403, "clock": "host", "stream": "runner", "sequence": 56706, "layer": "worker", "category": "message", "kind": "session.response", "role": "experiment-repo", "actor": "experiment-repo", "execution_id": "850fc1e5d1921cf13868244b1934a8e9", "trust": "agent-reported", "outcome": null, "label": "message", "repository": null, "flags": [], "causes": [], "summary": "response"}, {"id": "d0837b3b-b44d-57f4-8cd2-211ccc64c91c", "at": 1795716126.258482, "clock": "host", "stream": "runner", "sequence": 56707, "layer": "worker", "category": "usage", "kind": "session.usage", "role": "experiment-repo", "actor": "experiment-repo", "execution_id": "850fc1e5d1921cf13868244b1934a8e9", "trust": "agent-reported", "outcome": null, "label": "usage", "repository": null, "flags": [], "causes": [], "summary": "context usage"}, {"id": "8f2be385-d2e2-568c-b303-2041778c9e4d", "at": 1795716126.540258, "until": 1795716128.7455857, "clock": "host", "stream": "runner", "sequence": 56711, "layer": "worker", "category": "model", "kind": "model.request", "role": "experiment-repo", "actor": "experiment-repo", "execution_id": "850fc1e5d1921cf13868244b1934a8e9", "trust": "system-confirmed", "outcome": "completed", "label": "model → completed", "repository": null, "flags": [], "causes": [], "summary": "model request → completed in 1.7s (instruction ✓, activation ✓) [max_tokens 128000, output_config.effort high, thinking.display summar