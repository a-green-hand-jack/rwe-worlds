#!/usr/bin/env bash
# Submit one local-compute job per (benchmark, split). Each uses 1 CPU; results/raw/<bench>__<split>.pkl
cd "$(dirname "$0")/.."
for b in mmlu_pro bbh openllm_math gpqa musr arc_challenge ifeval legalbench commonsense gsm math med_qa mmlu; do
  for s in interp lineage extrap; do
    if [ "$b" = legalbench ] && [ "$s" = lineage ]; then continue; fi
    ht-resource run local-compute --cwd "$PWD" --cpus 1 --memory 6000 --note "$b-$s" -- \
      python3 -I -u scripts/02_run.py "$b" "$s" --draws 10 --d 2 --out results/raw > /dev/null
  done
done
