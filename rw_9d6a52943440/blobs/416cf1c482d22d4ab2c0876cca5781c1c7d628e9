"""Fig. 2 : RMSE ratio to uniform sampling vs n, one panel per split.
usage: python3 figures/scripts/fig2_ratio_vs_n.py CODE_DIR OUT_PDF
Source: results/ratio_by_n.csv (geometric mean over non-thin benchmarks, 95% family-bootstrap interval)."""
import sys
import matplotlib.pyplot as plt
import numpy as np
sys.path.insert(0, __file__.rsplit("/", 1)[0])
import style, common

style.apply()
R = common.Results(sys.argv[1])
rb = R.vs(R.csv("ratio_by_n.csv")); rb = rb[rb.flavour == "non_thin"]
shown = R.shown(rb.method.unique())
W, H = style.TEXT_WIDTH_IN, 2.3
fig, axs = plt.subplots(1, 3, figsize=(W, H), sharex=True, sharey=True)
for ax, sp in zip(axs, common.SPLITS):
    d = rb[rb.split == sp]
    for m, c in shown:
        g = d[d.method == m].sort_values("n")
        if g.empty:
            continue
        st = style.CLASS_STYLE[c]
        if m != common.BASE:
            ax.fill_between(g.n, g.ci_lo, g.ci_hi, color=st["color"], alpha=0.15, lw=0)
        ax.plot(g.n, g.geomean_ratio, color=st["color"], marker=st["marker"], ls=st["ls"], markersize=3.2, lw=1.0, label=common.label(m))
    ax.axhline(1, color="0.5", lw=0.6)
    ax.set_xscale("log"); ax.set_yscale("log")
    ax.set_xticks([10, 50, 100, 400]); ax.set_xticklabels([10, 50, 100, 400])
    ax.minorticks_off()
    ax.set_title(common.SPLIT_LABEL[sp], loc="left")
    nb = d.n_bench.max() if len(d) else 0
    ax.text(0.98, 0.04, f"{nb} benchmarks", transform=ax.transAxes, ha="right", fontsize=style.MIN_FONT_PT, color="0.35")
    ax.set_yticks([0.5, 0.7, 1, 1.5, 2, 3]); ax.yaxis.set_major_formatter(plt.FormatStrFormatter("%g"))
    ax.set_xlabel("items run, $n$")
axs[0].set_ylabel("RMSE / RMSE of uniform")
ylo = min(a.get_ylim()[0] for a in axs); yhi = max(a.get_ylim()[1] for a in axs)
for a in axs:
    a.set_ylim(ylo, yhi)
h, l = axs[0].get_legend_handles_labels()
fig.subplots_adjust(left=0.085, right=0.995, top=0.91, bottom=0.41, wspace=0.07)
fig.legend(h, l, loc="lower center", ncol=4, bbox_to_anchor=(0.5, 0.0), handlelength=2.2, columnspacing=1.2, labelspacing=0.3,
           title="method (design × estimator)", title_fontsize=style.MIN_FONT_PT)
plt.rcParams["savefig.bbox"] = "standard"; fig.savefig(sys.argv[2])
