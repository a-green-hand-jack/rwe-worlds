DESIGN_LABEL = {"uniform": "uniform", "strat": "stratified", "pps": "PPS", "balanced": "balanced",
                "anchor": "anchor", "infotop": "info-top", "cat": "IRT-CAT"}
EST_LABEL = {"mean": "mean", "calreg": "cal. reg.", "irt-model": "IRT model", "knn-model": "kNN model",
             "ridge-model": "ridge model", "irt-plugin": "IRT plug-in", "knn-plugin": "kNN plug-in",
             "ridge-plugin": "ridge plug-in", "diff-irt": "diff. IRT", "diff-knn": "diff. kNN",
             "diff-ridge": "diff. ridge", "diffnaive-irt": "diff. IRT (naive)",
             "recal-s": "recal. reg. (s)", "recal-sirt": "recal. reg. (s + IRT)", "recal-q": "recal. reg. (q)",
             "irtw-model": "IRT model, weak prior", "irtw-plugin": "IRT plug-in, weak prior"}


def label(m):
    d, e = m.split("|", 1)
    return f"{DESIGN_LABEL.get(d, d)} × {EST_LABEL.get(e, e)}"


# (method, class) shown in Fig. 2 / Fig. 7 / Table 1: one family each (class -> colour in style.CLASS_STYLE)
SHOWN = [
    ("uniform|mean", "uniform"),
    ("strat|mean", "stratified"),
    ("uniform|calreg", "regression"),
    ("anchor|irt-plugin", "anchor"),
    ("balanced|mean", "balanced"),
