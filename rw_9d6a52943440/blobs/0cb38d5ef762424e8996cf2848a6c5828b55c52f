]
# methods that also get a row against the second baseline strat|mean in Table 1
VS_STRAT = ["uniform|diff-irt", "balanced|calreg", "balanced|diff-irt", "pps|diff-irt"]
BASE2 = "strat|mean"


class Results:
    """Reads the CSVs of the results directory (path given on the command line)."""

    def __init__(self, root):
        self.root = root

    def has(self, name):
        import os
        path = f"{self.root}/results/{name}"
        return os.path.exists(path) or os.path.exists(path + ".gz")

    def csv(self, name):
        import os
        path = f"{self.root}/results/{name}"
        if not os.path.exists(path) and os.path.exists(path + ".gz"):
            path += ".gz"
        return pd.read_csv(path)

    def vs(self, df, baseline=BASE):
        """Rows of a primary/ratio_by_n frame against one baseline (the files carry both uniform|mean and strat|mean)."""
        return df[df.baseline == baseline] if "baseline" in df else df

    def shown(self, available):
        """SHOWN restricted to methods present; a missing one is reported, never replaced."""
        out = []
        for m, c in SHOWN:
            if m in set(available):
                out.append((m, c))
            else:
                print(f"WARNING: method {m} not in results; omitted from the figure", file=sys.stderr)
        return out

