        for m in shown:
            row = [tex(common.label(m))]
            for sp in SP:
                g = ps[(ps.method == m) & (ps.split == sp) & (ps.suite == su) & (ps.baseline == "uniform|mean")]
                row.append(cell(g.iloc[0]) if len(g) else "--")
            L.append(" & ".join(row) + r" \\")
        L.append(rf"\multicolumn{{{1 + len(SP)}}}{{l}}{{\emph{{{name}: against stratified $\times$ mean}}}} \\")
        for m in [m for m in common.VS_STRAT if m in set(avail)]:
            row = [tex(common.label(m))]
            for sp in SP:
                g = ps[(ps.method == m) & (ps.split == sp) & (ps.suite == su) & (ps.baseline == "strat|mean")]
                row.append(cell(g.iloc[0]) if len(g) else "--")
            L.append(" & ".join(row) + r" \\")
        row = ["Benchmarks"]
        for sp in SP:
            g = ps[(ps.method == "uniform|diff-irt") & (ps.split == sp) & (ps.suite == su) & (ps.baseline == "uniform|mean")]
