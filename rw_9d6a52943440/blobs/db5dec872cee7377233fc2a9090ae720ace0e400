# Secondary endpoint (appendix): n/N = 2% of each benchmark's items (label n = 0 in results/twopct; actual n in per_bench.n_actual)
if R.has("twopct/ratio_by_n.csv"):
    t2 = R.csv("twopct/ratio_by_n.csv"); t2 = t2[(t2.n == 0) & (t2.flavour == "non_thin")]
    tg2 = R.csv("twopct/targets.csv"); tg2 = tg2[~tg2.thin]
    av2 = set(t2.method)
    ncol = len(SP)
    L = [r"\begin{tabular}{l" + "c" * ncol + "}", r"\toprule",
         "Method (design $\\times$ estimator) & " + " & ".join(common.SPLIT_LABEL[sp] for sp in SP) + r" \\", r"\midrule"]

    def rows2(methods, base):
        for m in methods:
            row = [tex(common.label(m))]
            for sp in SP:
                g = R.vs(t2, base)
                g = g[(g.method == m) & (g.split == sp)]
                row.append(cell(g.iloc[0]) if len(g) else "--")
            L.append(" & ".join(row) + r" \\")

    rows2([m for m, _ in R.shown(av2)], common.BASE)
    if R.has("twopct/selected.csv"):
        sel2 = R.csv("twopct/selected.csv")
        L += [r"\midrule", r"\multicolumn{%d}{l}{\emph{Representative of each class chosen without the outcomes (leave-one-benchmark-out)}} \\" % (1 + ncol)]
        L += lobo_rows(ncol, sel=sel2)
    L += [r"\midrule", r"\multicolumn{%d}{l}{\emph{Against stratified $\times$ mean as the baseline}} \\" % (1 + ncol)]
    rows2([m for m in common.VS_STRAT if m in av2], common.BASE2)
    L.append(r"\midrule")
    for name, f in [("Benchmarks", len), ("Targets, summed over benchmarks", lambda t: t.k_targets.sum())]:
        L.append(name + " & " + " & ".join(str(int(f(tg2[tg2.split == sp]))) for sp in SP) + r" \\")
    L += [r"\bottomrule", r"\end{tabular}"]
    open(f"{out}/table6_twopct.tex", "w").write(wrap(L))
