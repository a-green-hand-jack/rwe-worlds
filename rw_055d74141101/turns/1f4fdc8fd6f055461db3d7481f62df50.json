t)\n    rows = []\n    for frac in FRACS:\n        for rep in range(a.reps if frac < 1 else 1):\n            rng = np.random.default_rng([a.seed, int(frac * 1000), rep])\n            dd = subsample(d, frac, rng)\narena55k.parquet\nmtbench_human.parquet\narena rep 240 3153\narena rep 260 3394\narena rep 280 3638\n```", "exit": null}}}, {"id": "6be55388-d60f-53c8-9a95-88d7b11404ec", "at": 1795676770.1298995, "clock": "host", "stream": "runner", "sequence": 41903, "layer": "worker", "category": "usage", "kind": "session.usage", "role": "experiment-repo", "actor": "experiment-repo", "execution_id": "1f4fdc8fd6f055461db3d7481f62df50", "trust": "agent-reported", "outcome": null, "label": "usage", "repository": null, "flags": [], "causes": [], "summary": "context usage"}, {"id": "da0c5ea5-56a8-5c67-950b-52d1cd30b95e", "at": 1795676770.1539793, "clock": "host", "stream": "runner", "sequence": 41904, "layer": "worker", "category": "message", "kind": "session.session/request_permission", "role": "experiment-repo", "actor": "experiment-repo", "execution_id": "1f4fdc8fd6f055461db3d7481f62df50", "trust": "agent-reported", "outcome": null, "label": "message", "repository": null, "flags": [], "causes": [], "summary": "session/request_permission"}, {"id": "5d1b7a36-f2c5-50b0-91a8-cc706eceb8ea", "at": 1795676770.1562867, "clock": "host", "stream": "runner", "sequence": 41905, "layer": "worker", "category": "message", "kind": "session.response", "role": "experiment-repo", "actor": "experiment-repo", "execution_id": "1f4fdc8fd6f055461db3d7481f62df50", "trust": "agent-reported", "outcome": null, "label": "message", "repository": null, "flags": [], "causes": [], "summary": "response"}, {"id": "52dccfd6-fe3b-5304-94cc-81e1046c91db", "at": 1795676770.3094795, "until": 1795676774.727081, "clock": "host", "stream": "runner", "sequence": 41909, "layer": "worker", "category": "model", "kind": "model.request", "role": "experiment-repo", "actor": "experiment-repo", "execution_id": "1f4fdc8fd6f0